import core::collection::{Len, AsSlice};
import std::mem::{enter_drop, defer_drop, leave_drop, alloc_in, dealloc_in, try_alloc_in, alloc_elems, try_alloc_elems, dealloc_elems, Allocator, Global, AllocError, out_of_memory, try_alloc};
import std::collections::{Vec, Hash, Eq, hash_key};

pub fn ResultOf[F: ?linear]() -> type {
    comptime let info = @fn_info(F);
    return info.ret;
}

/// Monotonic milliseconds.
pub fn now_ms() -> i64 {
    let mut time: [i64; 2] = .{ 0, 0 };
    let _rc = unsafe { clock_gettime(1, &raw mut time) };
    return time[0] * 1000 + time[1] / 1000000;
}

/// Sleeps the running thread for `ms` milliseconds.
pub fn sleep_ms(ms: i64) {
    let end = now_ms() + ms;
    while now_ms() < end {
        let mut step = (end - now_ms()) * 1000;
        if step > 1000000 {
            step = 1000000;
        }
        if step > 0 {
            let _rc = usleep(step as u32);
        }
    }
}

/// Guards the waiter lists of every `OnceLock` and `LazyLock`.
static mut ONCE_LOCK: [u64; 8] = .{ 0, 0, 0, 0, 0, 0, 0, 0 };

safe extern fn usleep(usec: u32) -> i32;
extern fn pthread_mutex_init(mutex: *mut u8, attr: *const u8) -> i32;
extern fn pthread_mutex_lock(mutex: *mut u8) -> i32;
extern fn pthread_mutex_unlock(mutex: *mut u8) -> i32;
extern fn pthread_mutex_destroy(mutex: *mut u8) -> i32;
extern fn pthread_cond_init(cond: *mut u8, attr: *const u8) -> i32;
extern fn pthread_cond_wait(cond: *mut u8, mutex: *mut u8) -> i32;
extern fn pthread_cond_timedwait(cond: *mut u8, mutex: *mut u8, deadline: *const [i64; 2]) -> i32;
extern fn clock_gettime(clock: i32, time: *mut [i64; 2]) -> i32;
extern fn pthread_cond_signal(cond: *mut u8) -> i32;
extern fn pthread_cond_broadcast(cond: *mut u8) -> i32;
extern fn pthread_cond_destroy(cond: *mut u8) -> i32;

/// Asserts that a value may move to another thread although its type is not `send` (one raw
/// pointer handed to a worker, say). `new` is `unsafe`: the caller vouches for that one value.
pub opaque(unsafe send) UnsafeSend[T: ?linear] {
    value: T,

    pub unsafe fn new(value: T) -> Self {
        return Self { value: value };
    }

    pub fn get(&self) -> &T {
        return &self.value;
    }

    pub fn get_mut(&mut self) -> &mut T {
        return &mut self.value;
    }

    pub fn into_inner(self) -> T {
        return self.value;
    }
}

/// Asserts that a value may be shared between threads although its type is not `sync`. `new`
/// is `unsafe`: the caller vouches that every access to that one value is synchronized.
pub opaque(unsafe sync) UnsafeSync[T: ?linear] {
    value: T,

    pub unsafe fn new(value: T) -> Self {
        return Self { value: value };
    }

    pub fn get(&self) -> &T {
        return &self.value;
    }

    pub fn get_mut(&mut self) -> &mut T {
        return &mut self.value;
    }

    pub fn into_inner(self) -> T {
        return self.value;
    }
}

pub opaque(linear) MutexGuard[T: send + ?linear] {
    raw_mtx: *mut u8,
    data_ptr: *ref mut T,

    pub(mod) fn create(raw_mtx: *mut u8, data_ptr: *ref mut T) -> Self {
        return Self {
            raw_mtx: raw_mtx,
            data_ptr: data_ptr,
        };
    }

    pub fn get(&self) -> &T {
        unsafe {
            return &self.data_ptr.*;
        }
    }

    pub fn get_mut(&mut self) -> &mut T {
        unsafe {
            return &mut self.data_ptr.*;
        }
    }

    pub fn unlock(self) {
        unsafe {
            let _rc = pthread_mutex_unlock(self.raw_mtx);
        }
    }
}

pub opaque(unsafe send, unsafe sync) Mutex[T: send + ?linear] {
    raw: [u64; 6],
    raw_handle: *mut u8,
    data: T,

    unsafe impl drop(may_dangle T) where T: !linear {
        fn drop(&mut self) {
            unsafe {
                let ptr = &mut self.raw[0] as *mut u64 as *mut u8;
                let _rc = pthread_mutex_destroy(ptr);
            }
        }
    }

    unsafe impl drop(may_dangle T) where T: linear {
        fn drop(&mut self) {
            unsafe {
                let ptr = &mut self.raw[0] as *mut u64 as *mut u8;
                let _rc = pthread_mutex_destroy(ptr);
            }
        }
    }

    pub fn into_inner(mut self) -> T {
        unsafe {
            let ptr = &mut self.raw[0] as *mut u64 as *mut u8;
            let _rc = pthread_mutex_destroy(ptr);
            let data_ptr: *mut T = &raw mut self.data;
            let val = move data_ptr.*;
            @forget(self);
            return val;
        }
    }

    pub fn new(val: T) -> Self {
        let mut m = Self {
            raw: .{ 0, 0, 0, 0, 0, 0 },
            raw_handle: 0 as *mut u8,
            data: val,
        };
        unsafe {
            let ptr = &mut m.raw[0] as *mut u64 as *mut u8;
            let _rc = pthread_mutex_init(ptr, 0 as *const u8);
        }
        return m;
    }

    /// The value, without locking: a `&mut Mutex` is the only way to it, so no other thread
    /// can hold the lock.
    pub fn get_mut(&mut self) -> &mut T {
        return &mut self.data;
    }

    pub fn lock(&self) -> MutexGuard[T] {
        let self_mut = self as *mut Self;
        unsafe {
            let raw_ptr = &mut self_mut.*.raw[0] as *mut u64 as *mut u8;
            let data_ptr = &mut self_mut.*.data as *ref mut T;
            let _rc = pthread_mutex_lock(raw_ptr);
            return MutexGuard[T]::create(raw_ptr, data_ptr);
        }
    }

    pub fn with_lock[F: callable(&mut T) -> i32](&self, f: F) -> i32 {
        let mut guard = self.lock();
        let out: i32 = f(guard.get_mut());
        guard.unlock();
        return out;
    }
}

pub opaque(unsafe sync) Waiter {
    raw_mtx: [u64; 6],
    raw_cv: [u64; 6],
    state: i32,
    timeout_us: u64,
    timeout_branch: i32,

    impl drop {
        fn drop(&mut self) {
            unsafe {
                let cv_ptr = (&mut self.raw_cv[0] as *mut u64 as usize) as *mut u8;
                let mtx_ptr = (&mut self.raw_mtx[0] as *mut u64 as usize) as *mut u8;
                let _rc1 = pthread_cond_destroy(cv_ptr);
                let _rc2 = pthread_mutex_destroy(mtx_ptr);
            }
        }
    }

    pub fn new() -> Self {
        let mut w = Self {
            raw_mtx: .{ 0, 0, 0, 0, 0, 0 },
            raw_cv: .{ 0, 0, 0, 0, 0, 0 },
            state: -1,
            timeout_us: 0,
            timeout_branch: -1,
        };
        unsafe {
            let mtx_ptr = (&mut w.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let cv_ptr = (&mut w.raw_cv[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_init(mtx_ptr, 0 as *const u8);
            let _rc2 = pthread_cond_init(cv_ptr, 0 as *const u8);
        }
        return w;
    }

    pub(mod) fn try_claim(&self, branch_idx: i32) -> bool {
        let self_mut = self as *mut Self;
        unsafe {
            let mtx_ptr = (&mut self_mut.*.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let cv_ptr = (&mut self_mut.*.raw_cv[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_lock(mtx_ptr);
            if self_mut.*.state == -1 {
                self_mut.*.state = branch_idx;
                let _rc2 = pthread_cond_signal(cv_ptr);
                let _rc3 = pthread_mutex_unlock(mtx_ptr);
                return true;
            }
            let _rc4 = pthread_mutex_unlock(mtx_ptr);
            return false;
        }
    }

    pub(mod) fn set_timeout(&self, delay_us: u64, branch_idx: i32) {
        let self_mut = self as *mut Self;
        unsafe {
            let mtx_ptr = (&mut self_mut.*.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_lock(mtx_ptr);
            if self_mut.*.timeout_branch < 0 || delay_us < self_mut.*.timeout_us {
                self_mut.*.timeout_us = delay_us;
                self_mut.*.timeout_branch = branch_idx;
            }
            let _rc2 = pthread_mutex_unlock(mtx_ptr);
        }
    }

    pub fn winner(&self) -> i32 {
        let self_mut = self as *mut Self;
        unsafe {
            let mtx_ptr = (&mut self_mut.*.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_lock(mtx_ptr);
            let w = self_mut.*.state;
            let _rc2 = pthread_mutex_unlock(mtx_ptr);
            return w;
        }
    }

    /// Waits until a branch claims this waiter, or its timeout passes, and yields the branch.
    pub fn park(&self) -> i32 {
        let self_mut = self as *mut Self;
        unsafe {
            let mtx_ptr = (&mut self_mut.*.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let cv_ptr = (&mut self_mut.*.raw_cv[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_lock(mtx_ptr);
            if self_mut.*.timeout_branch >= 0 {
                let rem = self_mut.*.timeout_us;
                let mut deadline: [i64; 2] = .{ 0, 0 };
                let _rc_t = clock_gettime(0, &raw mut deadline);
                deadline[0] = deadline[0] + (rem / 1000000) as i64;
                deadline[1] = deadline[1] + ((rem % 1000000) * 1000) as i64;
                if deadline[1] >= 1000000000 {
                    deadline[0] = deadline[0] + 1;
                    deadline[1] = deadline[1] - 1000000000;
                }
                while self_mut.*.state == -1 {
                    if pthread_cond_timedwait(cv_ptr, mtx_ptr, &raw const deadline) != 0 {
                        break;
                    }
                }
                if self_mut.*.state == -1 {
                    self_mut.*.state = self_mut.*.timeout_branch;
                }
            } else {
                while self_mut.*.state == -1 {
                    let _rc_w = pthread_cond_wait(cv_ptr, mtx_ptr);
                }
            }
            let w = self_mut.*.state;
            let _rc2 = pthread_mutex_unlock(mtx_ptr);
            return w;
        }
    }
}

pub opaque(copy, unsafe sync) WaitNode {
    waiter: *const Waiter,
    branch_idx: i32,
    val_ptr: *mut u8,
    active: bool,

    pub fn new() -> Self {
        return Self {
            waiter: 0 as *const Waiter,
            branch_idx: -1,
            val_ptr: 0 as *mut u8,
            active: false,
        };
    }

    pub(mod) fn init(&mut self, waiter: *const Waiter, branch_idx: i32, val_ptr: *mut u8) {
        self.waiter = waiter;
        self.branch_idx = branch_idx;
        self.val_ptr = val_ptr;
        self.active = true;
    }

    pub(mod) fn deactivate(&mut self) {
        self.active = false;
    }

    pub(mod) fn is_active(&self) -> bool {
        return self.active;
    }

    pub(mod) fn get_waiter(&self) -> *const Waiter {
        return self.waiter;
    }

    pub(mod) fn get_branch_idx(&self) -> i32 {
        return self.branch_idx;
    }

    pub(mod) fn get_val_ptr(&self) -> *mut u8 {
        return self.val_ptr;
    }
}

pub struct Timer {
    pub delay_us: u64,

    pub fn after_us(delay_us: u64) -> Self {
        return Self {
            delay_us: delay_us,
        };
    }

    pub fn ready() -> Self {
        return Self {
            delay_us: 0,
        };
    }

    pub fn wait(&self) -> i32 {
        if self.delay_us > 0 {
            let _rc = usleep(self.delay_us as u32);
        }
        return 1;
    }

    pub fn recv(&self) -> i32 {
        return self.wait();
    }

    pub unsafe fn select_fast_recv(&self, out_ptr: *mut i32) -> bool {
        if self.delay_us == 0 {
            unsafe {
                out_ptr.* = 1;
            }
            return true;
        }
        return false;
    }

    pub unsafe fn select_register_recv(
        &self,
        node: *mut WaitNode,
        waiter: *const Waiter,
        branch_idx: i32,
        out_ptr: *mut i32
    ) -> bool {
        unsafe {
            out_ptr.* = 1;
            if self.delay_us == 0 {
                return waiter.*.try_claim(branch_idx);
            }
            node.*.init(waiter, branch_idx, out_ptr as *mut u8);
            waiter.*.set_timeout(self.delay_us, branch_idx);
            return false;
        }
    }

    pub unsafe fn select_unregister(&self, node: *mut WaitNode) {
        unsafe {
            node.*.deactivate();
        }
    }
}

pub opaque(unsafe send, unsafe sync) Channel[T: send + ?linear] {
    raw_mtx: [u64; 6],
    not_empty_cv: [u64; 6],
    not_full_cv: [u64; 6],
    buf: *own [uninit T; 64],
    cap: usize,
    head: usize,
    tail: usize,
    count: usize,
    recv_waiters: [*mut WaitNode; 8],
    send_waiters: [*mut WaitNode; 8],

    unsafe impl drop(may_dangle T) where T: !linear {
        fn drop(&mut self) {
            unsafe {
                while self.count > 0 {
                    let h_idx: usize = self.head;
                    let slot_ptr: *mut T = (&mut self.buf.*[h_idx] as *mut uninit T as usize) as *mut T;
                    @drop(slot_ptr);
                    self.head = (h_idx +% 1) % self.cap;
                    self.count = self.count -% 1;
                }
                Self::destroy_raw(self);
            }
        }
    }

    unsafe impl drop(may_dangle T) where T: linear {
        fn drop(&mut self) {
            unsafe {
                Self::destroy_raw(self);
            }
        }
    }

    fn destroy_raw(&mut self) {
        unsafe {
            let ne_ptr = (&mut self.not_empty_cv[0] as *mut u64 as usize) as *mut u8;
            let nf_ptr = (&mut self.not_full_cv[0] as *mut u64 as usize) as *mut u8;
            let mtx_ptr = (&mut self.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_cond_destroy(ne_ptr);
            let _rc2 = pthread_cond_destroy(nf_ptr);
            let _rc3 = pthread_mutex_destroy(mtx_ptr);
            @dealloc(self.buf);
        }
    }

    pub fn close_and_drain[F: callable(T)](mut self, f: F) {
        unsafe {
            while self.count > 0 {
                let h_idx: usize = self.head;
                let slot_ptr: *mut T = (&mut self.buf.*[h_idx] as *mut uninit T as usize) as *mut T;
                self.head = (h_idx +% 1) % self.cap;
                self.count = self.count -% 1;
                f(move slot_ptr.*);
            }
        }
    }

    pub fn with_capacity(cap: usize) -> Self {
        return Self::try_with_capacity(cap) catch |e| out_of_memory();
    }

    /// `with_capacity`, or why there is no memory for its buffer.
    pub fn try_with_capacity(cap: usize) -> AllocError!Self {
        let mut real_cap: usize = cap;
        if real_cap == 0 {
            real_cap = 1;
        }
        if real_cap > 64 {
            real_cap = 64;
        }
        let raw = try_alloc[[uninit T; 64]](1) orelse return .OutOfMemory;
        let buf_ptr: *own [uninit T; 64] = unsafe { raw as *own [uninit T; 64] };
        let mut ch = Self {
            raw_mtx: .{ 0, 0, 0, 0, 0, 0 },
            not_empty_cv: .{ 0, 0, 0, 0, 0, 0 },
            not_full_cv: .{ 0, 0, 0, 0, 0, 0 },
            buf: buf_ptr,
            cap: real_cap,
            head: 0,
            tail: 0,
            count: 0,
            recv_waiters: .{
                0 as *mut WaitNode, 0 as *mut WaitNode, 0 as *mut WaitNode, 0 as *mut WaitNode,
                0 as *mut WaitNode, 0 as *mut WaitNode, 0 as *mut WaitNode, 0 as *mut WaitNode
            },
            send_waiters: .{
                0 as *mut WaitNode, 0 as *mut WaitNode, 0 as *mut WaitNode, 0 as *mut WaitNode,
                0 as *mut WaitNode, 0 as *mut WaitNode, 0 as *mut WaitNode, 0 as *mut WaitNode
            },
        };
        unsafe {
            let mtx_ptr = (&mut ch.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let ne_ptr = (&mut ch.not_empty_cv[0] as *mut u64 as usize) as *mut u8;
            let nf_ptr = (&mut ch.not_full_cv[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_init(mtx_ptr, 0 as *const u8);
            let _rc2 = pthread_cond_init(ne_ptr, 0 as *const u8);
            let _rc3 = pthread_cond_init(nf_ptr, 0 as *const u8);
        }
        return ch;
    }

    pub fn new() -> Self {
        return Self::with_capacity(16);
    }

    /// `new`, or why there is no memory for its buffer.
    pub fn try_new() -> AllocError!Self {
        return Self::try_with_capacity(16);
    }

    fn try_push_locked(self_mut: *mut Self, val_ptr: *const T) -> bool {
        unsafe {
            let mut i: usize = 0;
            while i < 8 {
                let node: *mut WaitNode = self_mut.*.recv_waiters[i];
                if (node as usize) != 0 {
                    self_mut.*.recv_waiters[i] = 0 as *mut WaitNode;
                    if node.*.is_active() {
                        node.*.deactivate();
                        let w: *const Waiter = node.*.get_waiter();
                        if w.*.try_claim(node.*.get_branch_idx()) {
                            @memcpy(node.*.get_val_ptr() as *mut T, val_ptr, 1);
                            return true;
                        }
                    }
                }
                i = i +% 1;
            }
            if self_mut.*.count < self_mut.*.cap {
                let t_idx: usize = self_mut.*.tail;
                let slot_ptr: *mut T = (&mut self_mut.*.buf.*[t_idx] as *mut uninit T as usize) as *mut T;
                @memcpy(slot_ptr, val_ptr, 1);
                self_mut.*.tail = (t_idx +% 1) % self_mut.*.cap;
                self_mut.*.count = self_mut.*.count +% 1;
                let ne_ptr = (&mut self_mut.*.not_empty_cv[0] as *mut u64 as usize) as *mut u8;
                let _rc = pthread_cond_signal(ne_ptr);
                return true;
            }
            return false;
        }
    }

    fn try_pop_locked(self_mut: *mut Self, out_ptr: *mut T) -> bool {
        unsafe {
            if self_mut.*.count > 0 {
                let h_idx: usize = self_mut.*.head;
                let slot_ptr: *const T = (&mut self_mut.*.buf.*[h_idx] as *mut uninit T as usize) as *const T;
                @memcpy(out_ptr, slot_ptr, 1);
                self_mut.*.head = (h_idx +% 1) % self_mut.*.cap;
                self_mut.*.count = self_mut.*.count -% 1;
                let mut i: usize = 0;
                while i < 8 {
                    let snode: *mut WaitNode = self_mut.*.send_waiters[i];
                    if (snode as usize) != 0 {
                        self_mut.*.send_waiters[i] = 0 as *mut WaitNode;
                        if snode.*.is_active() {
                            snode.*.deactivate();
                            let sw: *const Waiter = snode.*.get_waiter();
                            if sw.*.try_claim(snode.*.get_branch_idx()) {
                                let t_idx: usize = self_mut.*.tail;
                                let dst_slot: *mut T = (&mut self_mut.*.buf.*[t_idx] as *mut uninit T as usize) as *mut T;
                                @memcpy(dst_slot, snode.*.get_val_ptr() as *const T, 1);
                                self_mut.*.tail = (t_idx +% 1) % self_mut.*.cap;
                                self_mut.*.count = self_mut.*.count +% 1;
                                i = 8;
                            }
                        }
                    }
                    if i < 8 {
                        i = i +% 1;
                    }
                }
                let nf_ptr = (&mut self_mut.*.not_full_cv[0] as *mut u64 as usize) as *mut u8;
                let _rc = pthread_cond_signal(nf_ptr);
                return true;
            }
            let mut j: usize = 0;
            while j < 8 {
                let snode: *mut WaitNode = self_mut.*.send_waiters[j];
                if (snode as usize) != 0 {
                    self_mut.*.send_waiters[j] = 0 as *mut WaitNode;
                    if snode.*.is_active() {
                        snode.*.deactivate();
                        let sw: *const Waiter = snode.*.get_waiter();
                        if sw.*.try_claim(snode.*.get_branch_idx()) {
                            @memcpy(out_ptr, snode.*.get_val_ptr() as *const T, 1);
                            return true;
                        }
                    }
                }
                j = j +% 1;
            }
            return false;
        }
    }

    pub fn try_send(&self, val: T) -> ?T borrows(val, self: val) {
        let self_mut = self as *mut Self;
        unsafe {
            let mtx_ptr = (&mut self_mut.*.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_lock(mtx_ptr);
            let val_ptr = (&val as *const T as usize) as *const T;
            let ok: bool = Self::try_push_locked(self_mut, val_ptr);
            let _rc2 = pthread_mutex_unlock(mtx_ptr);
            if ok {
                @forget(val);
                return null;
            }
            return val;
        }
    }

    /// Sends `val`, waiting while the channel is full.
    pub fn send(&self, val: T) borrows(self: val) {
        let self_mut = self as *mut Self;
        unsafe {
            let mtx_ptr = (&mut self_mut.*.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let nf_ptr = (&mut self_mut.*.not_full_cv[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_lock(mtx_ptr);
            let val_ptr = (&val as *const T as usize) as *const T;
            while !Self::try_push_locked(self_mut, val_ptr) {
                let _rc3 = pthread_cond_wait(nf_ptr, mtx_ptr);
            }
            @forget(val);
            let _rc2 = pthread_mutex_unlock(mtx_ptr);
        }
    }

    pub fn try_recv(&self) -> ?T borrows(self.*) {
        let self_mut = self as *mut Self;
        let mut slot: uninit T = uninit;
        unsafe {
            let mtx_ptr = (&mut self_mut.*.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_lock(mtx_ptr);
            let slot_ptr = (&mut slot as *mut uninit T as usize) as *mut T;
            let ok: bool = Self::try_pop_locked(self_mut, slot_ptr);
            let _rc2 = pthread_mutex_unlock(mtx_ptr);
            if ok {
                return move slot_ptr.*;
            }
            return null;
        }
    }

    /// The next value, waiting while the channel is empty.
    pub fn recv(&self) -> T borrows(self.*) {
        let self_mut = self as *mut Self;
        let mut slot: uninit T = uninit;
        unsafe {
            let mtx_ptr = (&mut self_mut.*.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let ne_ptr = (&mut self_mut.*.not_empty_cv[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_lock(mtx_ptr);
            let slot_ptr = (&mut slot as *mut uninit T as usize) as *mut T;
            while !Self::try_pop_locked(self_mut, slot_ptr) {
                let _rc3 = pthread_cond_wait(ne_ptr, mtx_ptr);
            }
            let _rc2 = pthread_mutex_unlock(mtx_ptr);
            return move slot_ptr.*;
        }
    }

    pub unsafe fn select_fast_recv(&self, out_ptr: *mut T) -> bool {
        let self_mut = self as *mut Self;
        unsafe {
            let mtx_ptr = (&mut self_mut.*.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_lock(mtx_ptr);
            let ok: bool = Self::try_pop_locked(self_mut, out_ptr);
            let _rc2 = pthread_mutex_unlock(mtx_ptr);
            return ok;
        }
    }

    pub unsafe fn select_fast_send(&self, val_ptr: *mut T) -> bool {
        let self_mut = self as *mut Self;
        unsafe {
            let mtx_ptr = (&mut self_mut.*.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_lock(mtx_ptr);
            let ok: bool = Self::try_push_locked(self_mut, val_ptr as *const T);
            let _rc2 = pthread_mutex_unlock(mtx_ptr);
            return ok;
        }
    }

    pub unsafe fn select_register_recv(
        &self,
        node: *mut WaitNode,
        waiter: *const Waiter,
        branch_idx: i32,
        out_ptr: *mut T
    ) -> bool {
        let self_mut = self as *mut Self;
        unsafe {
            let mtx_ptr = (&mut self_mut.*.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_lock(mtx_ptr);
            if waiter.*.winner() != -1 {
                let _rc_u = pthread_mutex_unlock(mtx_ptr);
                return false;
            }
            if self_mut.*.count > 0 {
                if waiter.*.try_claim(branch_idx) {
                    let _ok = Self::try_pop_locked(self_mut, out_ptr);
                    let _rc_u = pthread_mutex_unlock(mtx_ptr);
                    return true;
                }
            }
            node.*.init(waiter, branch_idx, out_ptr as *mut u8);
            let mut i: usize = 0;
            while i < 8 {
                if (self_mut.*.recv_waiters[i] as usize) == 0 {
                    self_mut.*.recv_waiters[i] = node;
                    i = 8;
                } else {
                    i = i +% 1;
                }
            }
            let _rc2 = pthread_mutex_unlock(mtx_ptr);
            return false;
        }
    }

    pub unsafe fn select_register_send(
        &self,
        node: *mut WaitNode,
        waiter: *const Waiter,
        branch_idx: i32,
        val_ptr: *mut T
    ) -> bool {
        let self_mut = self as *mut Self;
        unsafe {
            let mtx_ptr = (&mut self_mut.*.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_lock(mtx_ptr);
            if waiter.*.winner() != -1 {
                let _rc_u = pthread_mutex_unlock(mtx_ptr);
                return false;
            }
            if self_mut.*.count < self_mut.*.cap {
                if waiter.*.try_claim(branch_idx) {
                    let _ok = Self::try_push_locked(self_mut, val_ptr as *const T);
                    let _rc_u = pthread_mutex_unlock(mtx_ptr);
                    return true;
                }
            }
            node.*.init(waiter, branch_idx, val_ptr as *mut u8);
            let mut i: usize = 0;
            while i < 8 {
                if (self_mut.*.send_waiters[i] as usize) == 0 {
                    self_mut.*.send_waiters[i] = node;
                    i = 8;
                } else {
                    i = i +% 1;
                }
            }
            let _rc2 = pthread_mutex_unlock(mtx_ptr);
            return false;
        }
    }

    pub unsafe fn select_unregister(&self, node: *mut WaitNode) {
        let self_mut = self as *mut Self;
        unsafe {
            let mtx_ptr = (&mut self_mut.*.raw_mtx[0] as *mut u64 as usize) as *mut u8;
            let _rc1 = pthread_mutex_lock(mtx_ptr);
            node.*.deactivate();
            let mut i: usize = 0;
            while i < 8 {
                if (self_mut.*.recv_waiters[i] as usize) == (node as usize) {
                    self_mut.*.recv_waiters[i] = 0 as *mut WaitNode;
                }
                if (self_mut.*.send_waiters[i] as usize) == (node as usize) {
                    self_mut.*.send_waiters[i] = 0 as *mut WaitNode;
                }
                i = i +% 1;
            }
            let _rc2 = pthread_mutex_unlock(mtx_ptr);
        }
    }
}

fn once_lock() -> *mut u8 {
    return unsafe { &raw mut ONCE_LOCK[0] as *mut u64 as *mut u8 };
}

/// A unique non-zero token for the running thread.
thread_local static mut ONCE_CALLER: u8 = 0;

fn once_caller_id() -> usize {
    return unsafe { &raw mut ONCE_CALLER as usize };
}

struct OnceWaitNode {
    waiter: *const Waiter,
    next: usize,
}

unsafe fn once_wait(state: *mut u32, waiters: *mut usize) {
    unsafe {
        let lock = once_lock();
        while @atomic_load(state) != 2 {
            let w = Waiter::new();
            let mut node = OnceWaitNode {
                waiter: &raw const w,
                next: 0,
            };
            let _rc1 = pthread_mutex_lock(lock);
            if @atomic_load(state) == 2 {
                let _rc2 = pthread_mutex_unlock(lock);
                return;
            }
            node.next = waiters.*;
            waiters.* = &raw mut node as usize;
            let _rc3 = pthread_mutex_unlock(lock);
            let _winner = w.park();
        }
    }
}

unsafe fn once_wake_all(state: *mut u32, waiters: *mut usize) {
    unsafe {
        let lock = once_lock();
        let _rc1 = pthread_mutex_lock(lock);
        @atomic_store(state, 2);
        let mut head = waiters.*;
        waiters.* = 0;
        let _rc2 = pthread_mutex_unlock(lock);
        while head != 0 {
            let node = head as *mut OnceWaitNode;
            head = node.*.next;
            let _claimed = node.*.waiter.*.try_claim(0);
        }
    }
}

/// A thread-safe cell that can be written at most once and read through `&Self`.
pub opaque(unsafe send, unsafe sync) OnceLock[T: send + sync] {
    cell state: u32,
    cell owner: usize,
    cell waiters: usize,
    cell val: uninit T,

    impl default {
        fn default() -> Self {
            return Self::new();
        }
    }

    unsafe impl drop(may_dangle T) {
        fn drop(&mut self) {
            if self.state == 2 {
                unsafe {
                    @drop(&raw mut self.val as *mut T);
                }
            }
        }
    }

    pub fn new() -> Self {
        return Self {
            state: 0,
            owner: 0,
            waiters: 0,
            val: uninit,
        };
    }

    pub fn with_value(val: T) -> Self {
        return Self {
            state: 2,
            owner: 0,
            waiters: 0,
            val: uninit(val),
        };
    }

    pub fn get(&self) -> ?&T {
        unsafe {
            if @atomic_load(&raw mut self.state) == 2 {
                return &(&raw const self.val as *const T).*;
            }
        }
        return null;
    }

    pub fn get_mut(&mut self) -> ?&mut T {
        if self.state == 2 {
            unsafe {
                return &mut (&raw mut self.val as *mut T).*;
            }
        }
        return null;
    }

    /// Stores `val` if the cell is empty and returns `null`, or returns `val` back if full.
    /// Waits if another thread is currently initializing the cell, and traps on
    /// reentrant initialization by the same caller.
    pub fn set(&self, val: T) -> ?T borrows(val, self: val) {
        let caller = once_caller_id();
        unsafe {
            let state_ptr = &raw mut self.state;
            while true {
                let s = @atomic_load(state_ptr);
                if s == 2 {
                    return val;
                }
                if s == 0 {
                    let prev = @atomic_cas(state_ptr, 0, 1);
                    if prev == 0 {
                        @atomic_store(&raw mut self.owner, caller);
                        (&raw mut self.val as *mut T).* = val;
                        @atomic_store(&raw mut self.owner, 0);
                        once_wake_all(state_ptr, &raw mut self.waiters);
                        return null;
                    }
                } else {
                    if @atomic_load_relaxed(&raw mut self.owner) == caller {
                        @trap();
                    }
                    once_wait(state_ptr, &raw mut self.waiters);
                    return val;
                }
            }
            unreachable;
        }
    }

    /// Returns the cell's value, initializing it with `f()` if empty. Waits if another thread
    /// is currently initializing it, and traps if `f` re-enters.
    pub fn get_or_init[F: callable() -> T](&self, f: F) -> &T borrows(self, self: f) {
        let caller = once_caller_id();
        unsafe {
            let state_ptr = &raw mut self.state;
            while true {
                let s = @atomic_load(state_ptr);
                if s == 2 {
                    return &(&raw const self.val as *const T).*;
                }
                if s == 0 {
                    let prev = @atomic_cas(state_ptr, 0, 1);
                    if prev == 0 {
                        @atomic_store(&raw mut self.owner, caller);
                        let v = f();
                        (&raw mut self.val as *mut T).* = v;
                        @atomic_store(&raw mut self.owner, 0);
                        once_wake_all(state_ptr, &raw mut self.waiters);
                        return &(&raw const self.val as *const T).*;
                    }
                } else {
                    if @atomic_load_relaxed(&raw mut self.owner) == caller {
                        @trap();
                    }
                    once_wait(state_ptr, &raw mut self.waiters);
                }
            }
            unreachable;
        }
    }

    pub fn take(&mut self) -> ?T borrows(self.*) {
        if self.state == 2 {
            self.state = 0;
            unsafe {
                let p: *mut T = &raw mut self.val as *mut T;
                return move p.*;
            }
        }
        return null;
    }

    pub fn into_inner(mut self) -> ?T {
        return self.take();
    }
}

/// A thread-safe value initialized on first access by calling `F`.
pub opaque(unsafe send, unsafe sync) LazyLock[T: send + sync, F: send + callable() -> T = fn() -> T] {
    cell state: u32,
    cell owner: usize,
    cell waiters: usize,
    cell init: ?F,
    cell val: uninit T,

    // Only `T`: an initializer never called is dropped as it is, and its own drop may use
    // what it borrows.
    unsafe impl drop(may_dangle T) {
        fn drop(&mut self) {
            if self.state == 2 {
                unsafe {
                    @drop(&raw mut self.val as *mut T);
                }
            }
        }
    }

    pub fn new(init: F) -> Self {
        return Self {
            state: 0,
            owner: 0,
            waiters: 0,
            init: init,
            val: uninit,
        };
    }

    pub fn is_initialized(&self) -> bool {
        unsafe {
            return @atomic_load(&raw mut self.state) == 2;
        }
    }

    /// Forces evaluation if not yet initialized and returns a shared reference to the value.
    pub fn get(&self) -> &T {
        let caller = once_caller_id();
        unsafe {
            let state_ptr = &raw mut self.state;
            while true {
                let s = @atomic_load(state_ptr);
                if s == 2 {
                    return &(&raw const self.val as *const T).*;
                }
                if s == 0 {
                    let prev = @atomic_cas(state_ptr, 0, 1);
                    if prev == 0 {
                        @atomic_store(&raw mut self.owner, caller);
                        let f = core::mem::replace(&mut (&raw mut self.init).*, null) orelse unreachable;
                        let v = f();
                        (&raw mut self.val as *mut T).* = v;
                        @atomic_store(&raw mut self.owner, 0);
                        once_wake_all(state_ptr, &raw mut self.waiters);
                        return &(&raw const self.val as *const T).*;
                    }
                } else {
                    if @atomic_load_relaxed(&raw mut self.owner) == caller {
                        @trap();
                    }
                    once_wait(state_ptr, &raw mut self.waiters);
                }
            }
            unreachable;
        }
    }

    /// Forces evaluation if not yet initialized and returns an exclusive reference to the value.
    pub fn get_mut(&mut self) -> &mut T {
        let _ = self.get();
        unsafe {
            return &mut (&raw mut self.val as *mut T).*;
        }
    }

    /// Returns the initialized value if already forced, or `null` if never forced.
    pub fn into_inner(mut self) -> ?T {
        if self.state == 2 {
            self.state = 0;
            unsafe {
                let p: *mut T = &raw mut self.val as *mut T;
                return move p.*;
            }
        }
        return null;
    }
}

/// Past this many references a count would be near overflowing, which only leaking them can do.
const MAX_ARC_REFS: usize = isize::MAX as usize;

/// The weak count while `Arc::get_mut` checks that nothing else refers to the value.
const WEAK_LOCKED: usize = usize::MAX;

/// What an `Arc` and its `WeakArc`s point at. `weak` counts the `WeakArc`s and one more for the
/// `Arc`s together, so the block outlives the value while a `WeakArc` remains.
struct ArcInner[T: ?linear] {
    strong: usize,
    weak: usize,
    value: uninit T,
}

/// Gives up one weak reference to `inner`, freeing it with the last.
fn arc_release_weak[T: ?linear, A: Allocator + copy](inner: *mut ArcInner[T], allocator: &A) {
    unsafe {
        if @atomic_sub(&raw mut inner.*.weak, 1) == 1 {
            dealloc_in[ArcInner[T], A](allocator, inner);
        }
    }
}

/// `Rc` for values shared between threads: the counts are atomic, and the value is `send` and
/// `sync`, as every thread holding an `Arc` reads it. To change it from several threads, share
/// a `Mutex` (`Arc[Mutex[T]]`) or a type with atomic `cell`s.
///
/// Values that refer to one another in a cycle are never dropped; break the cycle with
/// `WeakArc`.
pub opaque(owns T, unsafe send, unsafe sync) Arc[T: send + sync + ?linear, A: Allocator + copy + send + sync = Global] {
    inner: *mut ArcInner[T],
    allocator: A,

    impl clone where T: !linear {
        fn clone(&self) -> Self {
            return self.share();
        }
    }

    impl default where T: default, A: default {
        fn default() -> Self {
            return Self::new(@default(T));
        }
    }

    impl format where T: format {
        fn format(&self, f: &mut Formatter) {
            @format(f, self.get());
        }
    }

    unsafe impl drop(may_dangle T) where T: !linear, T: !recursive {
        fn drop(&mut self) {
            Self::release(self.inner, &self.allocator);
        }
    }

    /// A linear `Arc` ends only in `into_inner`, which forgets it, so this never runs.
    unsafe impl drop(may_dangle T) where T: linear {
        fn drop(&mut self) {
            @trap();
        }
    }

    unsafe impl drop(may_dangle T) where T: !linear, T: recursive {
        fn drop(&mut self) {
            if !enter_drop() {
                unsafe {
                    let later: *own Self = @alloc(Self, 1) as *own Self;
                    later.* = Self { inner: self.inner, allocator: self.allocator };
                    defer_drop(fn(kept: usize) {
                        unsafe {
                            let kept = kept as *own Self;
                            let arc = move kept.*;
                            @dealloc(kept);
                        }
                    }, later as usize);
                }
                return;
            }
            Self::release(self.inner, &self.allocator);
            leave_drop();
        }
    }

    /// Gives up one strong reference, dropping the value with the last.
    fn release(inner: *mut ArcInner[T], allocator: &A) where T: !linear {
        unsafe {
            // Sequentially consistent, so what every other holder did to the value happens
            // before the last drops it.
            if @atomic_sub(&raw mut inner.*.strong, 1) == 1 {
                @drop(&raw mut inner.*.value as *mut T);
                arc_release_weak[T, A](inner, allocator);
            }
        }
    }

    /// `clone`, which copies a reference and allocates nothing, so cannot fail.
    pub fn try_clone(&self) -> AllocError!Self where T: !linear {
        return self.share();
    }

    /// One more reference to the value: what `clone` does, and for a linear `T`, whose
    /// `Arc` is linear too and so cannot `clone`, the way to share it.
    pub fn share(&self) -> Self {
        let inner = self.inner;
        unsafe {
            // Relaxed: the new reference comes from one already held, so it orders nothing.
            if @atomic_add_relaxed(&raw mut inner.*.strong, 1) >= MAX_ARC_REFS {
                @trap();
            }
        }
        return Self { inner: inner, allocator: self.allocator };
    }

    pub(mod) fn from_inner(inner: *mut ArcInner[T], allocator: A) -> Self {
        return Self { inner: inner, allocator: allocator };
    }

    pub fn new(value: T) -> Self where A: default {
        return Self::new_in(value, @default(A));
    }

    /// `new`, or why there is no memory for it (and then `value` is dropped).
    pub fn try_new(value: T) -> AllocError!Self where A: default, T: !linear {
        let allocator: A = @default(A);
        let inner: *mut ArcInner[T] = try try_alloc_in[ArcInner[T], A](&allocator, 1);
        unsafe {
            inner.* = ArcInner[T] { strong: 1, weak: 1, value: uninit(value) };
        }
        return Self { inner: inner, allocator: allocator };
    }

    pub fn new_in(value: T, allocator: A) -> Self borrows(value, allocator) {
        let inner: *mut ArcInner[T] = unsafe { alloc_in[ArcInner[T], A](&allocator, 1) };
        unsafe {
            inner.* = ArcInner[T] { strong: 1, weak: 1, value: uninit(value) };
        }
        return Self { inner: inner, allocator: allocator };
    }

    pub fn get(&self) -> &T {
        unsafe {
            return &(&raw const self.inner.*.value as *const T).*;
        }
    }

    /// The value, if this is its only `Arc` and no `WeakArc` refers to it.
    pub fn get_mut(&mut self) -> ?&mut T {
        if !self.is_unique() {
            return null;
        }
        unsafe {
            return &mut (&raw mut self.inner.*.value as *mut T).*;
        }
    }

    /// The value to change: this `Arc`'s own, cloned first if anything else refers to it.
    pub fn make_mut(&mut self) -> &mut T where T: clone {
        if !self.is_unique() {
            let copy = Self::new_in(@clone(self.get()), self.allocator);
            self.* = copy;
        }
        unsafe {
            return &mut (&raw mut self.inner.*.value as *mut T).*;
        }
    }

    /// The value, if this was its last `Arc`; otherwise this one is dropped, and `null`. Of
    /// `Arc`s given up this way on several threads at once, exactly one gets the value.
    pub fn into_inner(self) -> ?T {
        let inner = self.inner;
        let allocator = self.allocator;
        unsafe {
            @forget(self);
            if @atomic_sub(&raw mut inner.*.strong, 1) != 1 {
                return null;
            }
            let value = move (&raw mut inner.*.value as *mut T).*;
            arc_release_weak[T, A](inner, &allocator);
            return value;
        }
    }

    /// The value, taken if this was its last `Arc` and cloned otherwise.
    pub fn unwrap_or_clone(self) -> T where T: clone {
        let inner = self.inner;
        unsafe {
            if @atomic_cas(&raw mut inner.*.strong, 1, 0) == 1 {
                let allocator = self.allocator;
                @forget(self);
                let value = move (&raw mut inner.*.value as *mut T).*;
                arc_release_weak[T, A](inner, &allocator);
                return value;
            }
        }
        return @clone(self.get());
    }

    /// A `WeakArc` reference to the value, which does not keep it alive.
    pub fn downgrade(&self) -> WeakArc[T, A] {
        let inner = self.inner;
        unsafe {
            let weak = &raw mut inner.*.weak;
            while true {
                let w = @atomic_load(weak);
                // `get_mut` holds it for a moment: wait for it.
                if w == WEAK_LOCKED {
                    continue;
                }
                if w >= MAX_ARC_REFS {
                    @trap();
                }
                if @atomic_cas(weak, w, w + 1) == w {
                    break;
                }
            }
        }
        return WeakArc[T, A]::from_inner(inner, self.allocator);
    }

    /// Whether `self` and `other` share a value.
    pub fn ptr_eq(&self, other: &Self) -> bool {
        return self.inner as usize == other.inner as usize;
    }

    /// The `Arc`s of the value, which other threads may change at any moment.
    pub fn strong_count(&self) -> usize {
        return unsafe { @atomic_load(&raw mut self.inner.*.strong) };
    }

    /// The `WeakArc`s of the value, which other threads may change at any moment.
    pub fn weak_count(&self) -> usize {
        let w = unsafe { @atomic_load(&raw mut self.inner.*.weak) };
        if w == WEAK_LOCKED {
            return 0;
        }
        return w - 1;
    }

    /// Whether nothing else refers to the value. The weak count is locked while the strong one
    /// is read, as otherwise another thread could make a `WeakArc` from a second `Arc` and drop
    /// that `Arc` between the two reads.
    fn is_unique(&mut self) -> bool {
        let inner = self.inner;
        unsafe {
            if @atomic_cas(&raw mut inner.*.weak, 1, WEAK_LOCKED) != 1 {
                return false;
            }
            let unique = @atomic_load(&raw mut inner.*.strong) == 1;
            @atomic_store(&raw mut inner.*.weak, 1);
            return unique;
        }
    }
}

/// A reference to an `Arc`'s value that does not keep it alive: `upgrade` gives an `Arc` while
/// one remains. It keeps the counts' memory, but not the value's resources, until it is dropped.
pub opaque(unsafe send, unsafe sync) WeakArc[T: send + sync + ?linear, A: Allocator + copy + send + sync = Global] {
    /// Null for a `WeakArc` made by `new`, which refers to nothing.
    inner: *mut ArcInner[T],
    allocator: A,

    impl clone {
        fn clone(&self) -> Self {
            let inner = self.inner;
            if inner as usize != 0 {
                unsafe {
                    // This one keeps the count above 1, so `get_mut` cannot have locked it.
                    if @atomic_add_relaxed(&raw mut inner.*.weak, 1) >= MAX_ARC_REFS {
                        @trap();
                    }
                }
            }
            return Self { inner: inner, allocator: self.allocator };
        }
    }

    impl default where A: default {
        fn default() -> Self {
            return Self::new();
        }
    }

    unsafe impl drop(may_dangle T) {
        fn drop(&mut self) {
            if self.inner as usize != 0 {
                arc_release_weak[T, A](self.inner, &self.allocator);
            }
        }
    }

    pub(mod) fn from_inner(inner: *mut ArcInner[T], allocator: A) -> Self {
        return Self { inner: inner, allocator: allocator };
    }

    /// A `WeakArc` that refers to nothing, so never upgrades.
    pub fn new() -> Self where A: default {
        return Self { inner: 0 as *mut ArcInner[T], allocator: @default(A) };
    }

    /// An `Arc` of the value, if one is still alive.
    pub fn upgrade(&self) -> ?Arc[T, A] {
        let inner = self.inner;
        if inner as usize == 0 {
            return null;
        }
        unsafe {
            let strong = &raw mut inner.*.strong;
            while true {
                let n = @atomic_load(strong);
                if n == 0 {
                    return null;
                }
                if n >= MAX_ARC_REFS {
                    @trap();
                }
                if @atomic_cas(strong, n, n + 1) == n {
                    break;
                }
            }
        }
        return Arc[T, A]::from_inner(inner, self.allocator);
    }

    /// Whether `self` and `other` refer to the same value (two made by `new` do).
    pub fn ptr_eq(&self, other: &Self) -> bool {
        return self.inner as usize == other.inner as usize;
    }

    /// The `Arc`s of the value, 0 once it is dropped.
    pub fn strong_count(&self) -> usize {
        if self.inner as usize == 0 {
            return 0;
        }
        return unsafe { @atomic_load(&raw mut self.inner.*.strong) };
    }

    /// The `WeakArc`s of the value, 0 once it is dropped.
    pub fn weak_count(&self) -> usize {
        if self.strong_count() == 0 {
            return 0;
        }
        let w = unsafe { @atomic_load(&raw mut self.inner.*.weak) };
        if w == WEAK_LOCKED {
            return 0;
        }
        return w - 1;
    }
}

/// What an `ArcSlice` points at: the count, and its elements.
struct ArcSliceInner[T] {
    strong: usize,
    len: usize,
    elems: *mut T,
}

/// `RcSlice` for elements shared between threads: the count is atomic, and the elements are
/// `send` and `sync`. The handle is one pointer. There is no weak form.
pub opaque(owns T, unsafe send, unsafe sync) ArcSlice[T: send + sync, A: Allocator + copy + send + sync = Global] {
    inner: *mut ArcSliceInner[T],
    allocator: A,

    impl clone {
        fn clone(&self) -> Self {
            let inner = self.inner;
            unsafe {
                if @atomic_add_relaxed(&raw mut inner.*.strong, 1) >= MAX_ARC_REFS {
                    @trap();
                }
            }
            return Self { inner: inner, allocator: self.allocator };
        }
    }

    impl default where A: default {
        fn default() -> Self {
            return Self::with_len(0, @default(A));
        }
    }

    impl format where T: format {
        fn format(&self, f: &mut Formatter) {
            @format(f, self.get());
        }
    }

    unsafe impl drop(may_dangle T) {
        fn drop(&mut self) {
            let inner = self.inner;
            unsafe {
                if @atomic_sub(&raw mut inner.*.strong, 1) == 1 {
                    let elems = inner.*.elems;
                    for i in 0..inner.*.len {
                        @drop(elems + i);
                    }
                    dealloc_elems[T, A](&self.allocator, elems, inner.*.len);
                    dealloc_in[ArcSliceInner[T], A](&self.allocator, inner);
                }
            }
        }
    }

    /// One reference to room for `len` elements, which the caller fills.
    fn with_len(len: usize, allocator: A) -> Self {
        return Self::try_with_len(len, allocator) catch |e| out_of_memory();
    }

    /// `with_len`, or why there is no memory for it (and then none is held).
    fn try_with_len(len: usize, allocator: A) -> AllocError!Self {
        let elems = try try_alloc_elems[T, A](&allocator, len);
        let inner: *mut ArcSliceInner[T] = try_alloc_in[ArcSliceInner[T], A](&allocator, 1) catch |e| {
            unsafe { dealloc_elems[T, A](&allocator, elems, len); }
            return e;
        };
        unsafe {
            inner.* = ArcSliceInner[T] { strong: 1, len: len, elems: elems };
        }
        return Self { inner: inner, allocator: allocator };
    }

    /// The elements of `items`, copied, or why there is no memory for them.
    pub fn try_from_slice(items: &[T]) -> AllocError!Self where T: copy, A: default {
        let out = try Self::try_with_len(items.len(), @default(A));
        let elems = out.elems();
        for i in 0..items.len() {
            unsafe {
                (elems + i).* = items[i];
            }
        }
        return out;
    }

    /// The elements of `items`, moved, or why there is no memory for them (and then `items` is
    /// dropped).
    pub fn try_from_vec(items: Vec[T]) -> AllocError!Self where A: default {
        let mut items = items;
        let len = items.len();
        let out = try Self::try_with_len(len, @default(A));
        let elems = out.elems();
        let mut i = len;
        while let ?item = items.pop() {
            i -= 1;
            unsafe {
                (elems + i).* = item;
            }
        }
        return out;
    }

    fn elems(&self) -> *mut T {
        return unsafe { self.inner.*.elems };
    }

    /// The elements of `items`, cloned.
    pub fn from_slice(items: &[T]) -> Self where T: clone, A: default {
        return Self::from_slice_in(items, @default(A));
    }

    pub fn from_slice_in(items: &[T], allocator: A) -> Self where T: clone {
        let out = Self::with_len(items.len(), allocator);
        let elems = out.elems();
        for i in 0..items.len() {
            unsafe {
                (elems + i).* = @clone(&items[i]);
            }
        }
        return out;
    }

    /// The elements of `items`, moved.
    pub fn from_vec(items: Vec[T]) -> Self where A: default {
        let mut items = items;
        let len = items.len();
        let out = Self::with_len(len, @default(A));
        let elems = out.elems();
        let mut i = len;
        while let ?item = items.pop() {
            i -= 1;
            unsafe {
                (elems + i).* = item;
            }
        }
        return out;
    }

    pub fn get(&self) -> &[T] {
        unsafe {
            return self.elems()[0..self.inner.*.len];
        }
    }

    /// The elements, if this is their only `ArcSlice`. With no weak form, a count of one
    /// cannot rise while `self` is borrowed mutably.
    pub fn get_mut(&mut self) -> ?&mut [T] {
        if self.strong_count() != 1 {
            return null;
        }
        unsafe {
            return &mut self.elems()[0..self.inner.*.len];
        }
    }

    pub fn len(&self) -> usize {
        return unsafe { self.inner.*.len };
    }

    pub fn is_empty(&self) -> bool {
        return self.len() == 0;
    }

    /// Whether `self` and `other` share their elements.
    pub fn ptr_eq(&self, other: &Self) -> bool {
        return self.inner as usize == other.inner as usize;
    }

    /// The `ArcSlice`s of the elements, which other threads may change at any moment.
    pub fn strong_count(&self) -> usize {
        return unsafe { @atomic_load(&raw mut self.inner.*.strong) };
    }

    /// `clone`, which copies a reference and allocates nothing, so cannot fail.
    pub fn try_clone(&self) -> AllocError!Self {
        return self.clone();
    }
}

/// `RcStr` shared between threads: text shared by every `ArcStr` cloned from one another, one
/// pointer wide. `as_str` reads it; it never changes.
pub opaque ArcStr {
    bytes: ArcSlice[u8],

    impl clone {
        fn clone(&self) -> Self {
            return Self { bytes: self.bytes.clone() };
        }
    }

    impl default {
        fn default() -> Self {
            return Self::from("");
        }
    }

    impl format {
        fn format(&self, f: &mut Formatter) {
            f.write_str(self.as_str());
        }
    }

    pub fn from(text: &str) -> Self {
        return Self { bytes: ArcSlice[u8]::from_slice(text) };
    }

    /// `from`, or why there is no memory for it.
    pub fn try_from(text: &str) -> AllocError!Self {
        return Self { bytes: try ArcSlice[u8]::try_from_slice(text) };
    }

    pub fn as_str(&self) -> &str {
        return self.bytes.get();
    }

    pub fn len(&self) -> usize {
        return self.bytes.len();
    }

    pub fn is_empty(&self) -> bool {
        return self.bytes.is_empty();
    }

    /// Whether `self` and `other` share their text (not only equal it).
    pub fn ptr_eq(&self, other: &Self) -> bool {
        return self.bytes.ptr_eq(&other.bytes);
    }

    pub fn strong_count(&self) -> usize {
        return self.bytes.strong_count();
    }

    /// `clone`, which copies a reference and allocates nothing, so cannot fail.
    pub fn try_clone(&self) -> AllocError!Self {
        return self.clone();
    }
}

impl Hash for ArcStr {
    fn hash(&self) -> u64 {
        return hash_key[&str](self.as_str());
    }
}

impl Eq for ArcStr {
    fn eq(&self, other: &Self) -> bool {
        return self.as_str() == other.as_str();
    }
}

impl[T: send + sync, A: Allocator + copy + send + sync] Len for ArcSlice[T, A] {
    fn len(&self) -> usize {
        return ArcSlice[T, A]::len(self);
    }
}

impl[T: send + sync, A: Allocator + copy + send + sync] AsSlice for ArcSlice[T, A] {
    const Elem: type = T;
    fn as_slice(&self) -> &[T] {
        return ArcSlice[T, A]::get(self);
    }
}

impl Len for ArcStr {
    fn len(&self) -> usize {
        return ArcStr::len(self);
    }
}
