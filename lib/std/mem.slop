/// The program's allocator, named by `alias ProgramAllocator = A;` in the root module. `@alloc`,
/// `@realloc`, and `@dealloc` then call `A`, and a null result traps, as it does for the default.
/// `A` has no instance, so a call is direct.
///
/// An implementation promises what `Allocator` does, which is why it is `unsafe impl`.
pub unsafe trait GlobalAllocator {
    fn alloc(bytes: usize, align: usize) -> *mut u8;
    fn realloc(ptr: *mut u8, bytes: usize, align: usize) -> *mut u8;
    fn dealloc(ptr: *mut u8);
    /// `bytes` of zeros; unless an allocator has a faster way, what `alloc` gives, zeroed.
    fn alloc_zeroed(bytes: usize, align: usize) -> *mut u8 {
        let p = Self::alloc(bytes, align);
        if (p as usize) != 0 {
            for i in 0..bytes {
                unsafe {
                    *(p + i) = 0;
                }
            }
        }
        return p;
    }
}

/// What a container allocates through: `Vec[i32, A]` holds an `A`. A type with no fields costs
/// nothing there, and `&Pool` holds a reference, so the borrow checker keeps the container
/// inside the pool's lifetime.
///
/// Safe code trusts what this returns, so an implementation is `unsafe impl` and promises: a
/// non-null result is `bytes` long, aligned to `align`, and used by nothing else until it is given
/// back through `dealloc` (or moved by `realloc`, which keeps the contents up to the smaller
/// size); `realloc` and `dealloc` are given only pointers this allocator returned. Null means
/// there is no memory, and the containers trap on it.
pub unsafe trait Allocator {
    fn alloc(self: &Self, bytes: usize, align: usize) -> *mut u8;
    fn realloc(self: &Self, ptr: *mut u8, bytes: usize, align: usize) -> *mut u8;
    fn dealloc(self: &Self, ptr: *mut u8);
    /// `bytes` of zeros; unless an allocator has a faster way, what `alloc` gives, zeroed.
    fn alloc_zeroed(self: &Self, bytes: usize, align: usize) -> *mut u8 {
        let p = self.alloc(bytes, align);
        if (p as usize) != 0 {
            for i in 0..bytes {
                unsafe {
                    *(p + i) = 0;
                }
            }
        }
        return p;
    }
}

/// The program's allocator, as a value. The default for every container.
pub struct Global { }

unsafe impl Allocator for Global {
    fn alloc(self: &Self, bytes: usize, align: usize) -> *mut u8 {
        return @raw_alloc(bytes);
    }

    fn realloc(self: &Self, ptr: *mut u8, bytes: usize, align: usize) -> *mut u8 {
        return unsafe { @raw_realloc(ptr, bytes) };
    }

    fn dealloc(self: &Self, ptr: *mut u8) {
        unsafe { @dealloc(ptr); }
    }

    /// From the program's allocator, zeroed: by default `calloc`, whose fresh pages need no
    /// writing.
    fn alloc_zeroed(self: &Self, bytes: usize, align: usize) -> *mut u8 {
        return @raw_alloc_zeroed(bytes);
    }
}

unsafe impl[A: Allocator] Allocator for &A {
    fn alloc(self: &Self, bytes: usize, align: usize) -> *mut u8 {
        return (**self).alloc(bytes, align);
    }

    fn realloc(self: &Self, ptr: *mut u8, bytes: usize, align: usize) -> *mut u8 {
        return (**self).realloc(ptr, bytes, align);
    }

    fn dealloc(self: &Self, ptr: *mut u8) {
        (**self).dealloc(ptr);
    }

    fn alloc_zeroed(self: &Self, bytes: usize, align: usize) -> *mut u8 {
        return (**self).alloc_zeroed(bytes, align);
    }
}

/// Why memory could not be had: the allocator had none to give (`OutOfMemory`), or what was
/// asked for is more than could ever be given: a size that does not fit in a `usize`, or more
/// than a storage holds (a full `ArrayVec`).
pub error AllocError { OutOfMemory, TooLarge }

/// Room for `len` values of `T` from `allocator`, or why there is none. A zero-sized `T`
/// allocates nothing, as for `@alloc`.
pub fn try_alloc_in[T: ?linear, A: Allocator](allocator: &A, len: usize) -> AllocError!*mut T {
    if @size_of(T) == 0 {
        return (@align_of(T) as usize) as *mut T;
    }
    let bytes: usize = (len *? @size_of(T)) orelse return .TooLarge;
    let raw = allocator.alloc(bytes, @align_of(T));
    if (raw as usize) == 0 {
        return .OutOfMemory;
    }
    return raw as *mut T;
}

/// `ptr`'s values resized to `len`, or why not; on failure `ptr` is as it was.
pub fn try_realloc_in[T: ?linear, A: Allocator](allocator: &A, ptr: *mut T, len: usize) -> AllocError!*mut T {
    if @size_of(T) == 0 {
        return ptr;
    }
    let bytes: usize = (len *? @size_of(T)) orelse return .TooLarge;
    let raw = allocator.realloc(ptr as *mut u8, bytes, @align_of(T));
    if (raw as usize) == 0 {
        return .OutOfMemory;
    }
    return raw as *mut T;
}

/// `try_alloc_in`, trapping where it fails.
pub fn alloc_in[T: ?linear, A: Allocator](allocator: &A, len: usize) -> *mut T {
    return try_alloc_in[T, A](allocator, len) catch |e| @trap();
}

/// `try_realloc_in`, trapping where it fails.
pub fn realloc_in[T: ?linear, A: Allocator](allocator: &A, ptr: *mut T, len: usize) -> *mut T {
    return try_realloc_in[T, A](allocator, ptr, len) catch |e| @trap();
}

pub fn dealloc_in[T: ?linear, A: Allocator](allocator: &A, ptr: *mut T) {
    if @size_of(T) != 0 {
        allocator.dealloc(ptr as *mut u8);
    }
}

/// Where a container keeps its elements: behind an allocator (every `Allocator` is a storage), or
/// inside the container itself (`Slots`). The container holds a `Handle` the storage gave it, and
/// asks the storage for the memory behind it on each use, since inline memory moves with the
/// container. For an allocator the handle is the memory, and asking costs nothing; inline storage
/// needs no address, and its handle says only that there is memory.
///
/// Implementing it is unsafe, as for `Allocator`: safe code trusts that `grow` gives room for
/// `bytes` bytes aligned to `align` with the first `keep` kept, that `resolve` gives that memory
/// back for as long as the handle lives, and that nothing else uses it until `release`.
pub unsafe trait Storage {
    /// What the container keeps to find its memory by.
    const Handle: copy;
    /// The memory behind `h`.
    fn resolve(self: &Self, h: Self::Handle) -> *own u8;
    /// Room for `bytes`, keeping the first `keep` bytes behind `h` (when there is one): the new
    /// handle, or null when there is no room (and `h` is untouched).
    fn grow(self: &mut Self, h: ?Self::Handle, keep: usize, bytes: usize, align: usize) -> ?Self::Handle;
    /// Gives back the memory behind `h`, whose contents are dropped or moved out.
    fn release(self: &mut Self, h: Self::Handle);
    /// The most bytes it can give.
    fn limit(self: &Self) -> usize;
    /// An empty storage like this one, for a copy of the container.
    fn sibling(self: &Self) -> Self;
    /// Ends the storage of a container consumed whole, its contents moved out and its memory
    /// released. A linear storage (inline slots of linear values) is consumed only so.
    fn retire(move self) {
    }
}

/// What an allocator gave, owned, or null when it failed.
fn owned_or_null(raw: *mut u8) -> ?*own u8 {
    if (raw as usize) == 0 {
        return null;
    }
    return unsafe { raw as *own u8 };
}

/// An allocator is a storage whose handle is the allocation.
unsafe impl[A: Allocator + copy] Storage for A {
    const Handle: copy = *own u8;
    fn resolve(self: &Self, h: *own u8) -> *own u8 {
        return h;
    }
    /// `realloc` keeps what fits of the old block, so `keep` needs no copying here.
    fn grow(self: &mut Self, h: ?*own u8, keep: usize, bytes: usize, align: usize) -> ?*own u8 {
        if let old = h {
            return owned_or_null(self.realloc(old as *mut u8, bytes, align));
        }
        return owned_or_null(self.alloc(bytes, align));
    }
    fn release(self: &mut Self, h: *own u8) {
        self.dealloc(h as *mut u8);
    }
    fn limit(self: &Self) -> usize {
        return usize::MAX;
    }
    fn sibling(self: &Self) -> Self {
        return *self;
    }
}

/// Storage inside the container for `N` elements of `T`: `Vec[T, Slots[T, N]]` (`ArrayVec[T,
/// N]`) holds up to `N` with no allocation, and traps past it. It moves with the container, and
/// drops nothing itself: the container drops its elements.
pub opaque Slots[T: ?linear, N: usize] {
    slots: [uninit T; N],

    pub fn new() -> Self {
        return Self { slots: uninit };
    }

    impl default {
        fn default() -> Self {
            return Self::new();
        }
    }

    unsafe impl Storage {
        /// The slots are where they are; the handle only says there is memory.
        const Handle: copy = bool;
        fn resolve(self: &Self, h: bool) -> *own u8 {
            return unsafe { &self.slots as *const [uninit T; N] as *own u8 };
        }
        fn grow(self: &mut Self, h: ?bool, keep: usize, bytes: usize, align: usize) -> ?bool {
            if bytes > N * @size_of(T) || align > @align_of(T) {
                return null;
            }
            return true;
        }
        fn release(self: &mut Self, h: bool) {
        }
        fn limit(self: &Self) -> usize {
            return N * @size_of(T);
        }
        fn sibling(self: &Self) -> Self {
            return Self::new();
        }
        fn retire(move self) {
            // The container moved its values out of the slots; nothing is left in them.
            unsafe { @forget(self); }
        }
    }
}

pub safe extern fn malloc(size: usize) -> *mut u8;
pub extern fn realloc(ptr: *mut u8, size: usize) -> *mut u8;
pub extern fn free(ptr: *mut u8);

pub import core::mem::*;
import std::collections::{Vec, Hash, Eq, hash_key};

/// Fallible counterpart of `@alloc`: returns `null` instead of trapping when `len * size_of(T)`
/// overflows `usize` or the allocator is out of memory. For zero-sized `T`, returns the aligned
/// null-page pointer `@align_of(T) as *mut T` without allocating.
pub fn try_alloc[T: ?linear](len: usize) -> ?*mut T {
    if @size_of(T) == 0 {
        return (@align_of(T) as usize) as *mut T;
    }
    let mut bytes: usize = (len *? @size_of(T)) orelse return null;
    if bytes == 0 {
        bytes = 1;
    }
    let raw: *mut u8 = @raw_alloc(bytes);
    if (raw as usize) == 0 {
        return null;
    }
    return raw as *mut T;
}

/// How deeply boxes of a recursive type drop inside each other before the rest waits, which
/// keeps a list of any length from overflowing the stack.
const DROP_LIMIT: usize = 128;

/// A box that was too deep to drop where it was, and how to drop it.
struct DeferredDrop {
    next: usize,
    run: fn(usize),
    value: usize,
}

/// The nesting of recursive drops, and the first `DeferredDrop`. Both belong to the fiber.
thread_local static mut DROP_DEPTH: usize = 0;
thread_local static mut DROP_QUEUE: usize = 0;

/// Sets `DROP_DEPTH` and `DROP_QUEUE` for a fiber taking over, and returns what they were.
pub fn swap_drop_state(depth: usize, queue: usize) -> tuple { usize, usize } {
    unsafe {
        let old: tuple { usize, usize } = { DROP_DEPTH, DROP_QUEUE };
        DROP_DEPTH = depth;
        DROP_QUEUE = queue;
        return old;
    }
}

/// Whether a recursive drop may go deeper here.
pub fn enter_drop() -> bool {
    unsafe {
        if DROP_DEPTH == DROP_LIMIT {
            return false;
        }
        DROP_DEPTH = DROP_DEPTH + 1;
    }
    return true;
}

pub fn defer_drop(run: fn(usize), value: usize) {
    unsafe {
        let entry: *mut DeferredDrop = @alloc(DeferredDrop, 1) as *mut DeferredDrop;
        *entry = DeferredDrop { next: DROP_QUEUE, run: run, value: value };
        DROP_QUEUE = entry as usize;
    }
}

/// Ends a recursive drop. The outermost runs what went deeper than `DROP_LIMIT`, staying
/// the outermost while it does, so those drops only add to the queue it is emptying.
pub fn leave_drop() {
    unsafe {
        if DROP_DEPTH > 1 {
            DROP_DEPTH = DROP_DEPTH - 1;
            return;
        }
        while DROP_QUEUE != 0 {
            let entry = DROP_QUEUE as *mut DeferredDrop;
            DROP_QUEUE = (*entry).next;
            let run = (*entry).run;
            let value = (*entry).value;
            @dealloc(entry);
            run(value);
        }
        DROP_DEPTH = 0;
    }
}

pub opaque Box[T: ?linear, A: Allocator + copy = Global] {
    ptr: *own T,
    allocator: A,

    unsafe impl drop(may_dangle T) where T: !linear, T: !recursive {
        fn drop(self: &mut Self) {
            unsafe {
                @drop(self.ptr);
                dealloc_in[T, A](&self.allocator, self.ptr);
            }
        }
    }

    unsafe impl drop(may_dangle T) where T: !linear, T: recursive {
        fn drop(self: &mut Self) {
            unsafe {
                if !enter_drop() {
                    let later: *own Self = @alloc(Self, 1) as *own Self;
                    let ptr: *mut T = self.ptr;
                    *later = Self { ptr: ptr as *own T, allocator: self.allocator };
                    defer_drop(fn(kept: usize) {
                        unsafe {
                            let kept = kept as *own Self;
                            let boxed = move *kept;
                            @dealloc(kept);
                        }
                    }, later as usize);
                    return;
                }
                @drop(self.ptr);
                dealloc_in[T, A](&self.allocator, self.ptr);
                leave_drop();
            }
        }
    }

    unsafe impl drop(may_dangle T) where T: linear {
        fn drop(self: &mut Self) {
            unsafe {
                dealloc_in[T, A](&self.allocator, self.ptr);
            }
        }
    }

    pub fn into_inner(move self) -> T {
        unsafe {
            let p: *mut T = self.ptr;
            let val = move *p;
            dealloc_in[T, A](&self.allocator, p);
            @forget(self);
            return val;
        }
    }

    pub fn new(val: T) -> Self where A: default {
        return Self::new_in(move val, @default(A));
    }

    /// `new`, or why there is no memory for it (and then `val` is dropped).
    pub fn try_new(val: T) -> AllocError!Self where A: default, T: !linear {
        return Self::try_new_in(move val, @default(A));
    }

    pub fn try_new_in(val: T, allocator: A) -> AllocError!Self borrows(val, allocator) where T: !linear {
        let typed_ptr: *own T = unsafe { (try try_alloc_in[T, A](&allocator, 1)) as *own T };
        unsafe {
            *typed_ptr = move val;
        }
        return Self {
            ptr: typed_ptr,
            allocator: allocator,
        };
    }

    pub fn new_in(val: T, allocator: A) -> Self borrows(val, allocator) {
        let typed_ptr: *own T = unsafe { alloc_in[T, A](&allocator, 1) as *own T };
        unsafe {
            *typed_ptr = move val;
        }
        return Self {
            ptr: typed_ptr,
            allocator: allocator,
        };
    }

    pub fn get(self: &Self) -> &T {
        unsafe {
            return &*self.ptr;
        }
    }

    pub fn get_mut(self: &mut Self) -> &mut T {
        unsafe {
            return &mut *self.ptr;
        }
    }
}

/// Past this many references a count would be near overflowing, which only leaking them can do.
const MAX_REFS: usize = isize::MAX as usize;

/// What an `Rc` and its `Weak`s point at. `weak` counts the `Weak`s and one more for the `Rc`s
/// together, so the block outlives the value while a `Weak` remains.
struct RcInner[T: ?linear] {
    strong: usize,
    weak: usize,
    value: uninit T,
}

/// Gives up one weak reference to `inner`, freeing it with the last.
fn rc_release_weak[T: ?linear, A: Allocator + copy](inner: *mut RcInner[T], allocator: &A) {
    unsafe {
        let w = (*inner).weak - 1;
        (*inner).weak = w;
        if w == 0 {
            dealloc_in[RcInner[T], A](allocator, inner);
        }
    }
}

/// A value shared by the `Rc`s cloned from one another, dropped with the last of them. `clone`
/// copies the reference, not the value, and `get` reads it; changing it takes `get_mut` (while
/// this is the only `Rc`), `make_mut`, or a `cell` inside it. The counts are not atomic, so an
/// `Rc` stays on its thread: share across threads with `Arc`.
///
/// Values that refer to one another in a cycle are never dropped; break the cycle with `Weak`.
pub opaque(owns T, !send, !sync) Rc[T: ?linear, A: Allocator + copy = Global] {
    inner: *mut RcInner[T],
    allocator: A,

    impl clone where T: !linear {
        fn clone(self: &Self) -> Self {
            return self.share();
        }
    }

    impl default where T: default, A: default {
        fn default() -> Self {
            return Self::new(@default(T));
        }
    }

    impl format where T: format {
        fn format(self: &Self, f: &mut Formatter) {
            @format(f, self.get());
        }
    }

    unsafe impl drop(may_dangle T) where T: !linear, T: !recursive {
        fn drop(self: &mut Self) {
            Self::release(self.inner, &self.allocator);
        }
    }

    /// A linear `Rc` ends only in `into_inner`, which forgets it, so this never runs.
    unsafe impl drop(may_dangle T) where T: linear {
        fn drop(self: &mut Self) {
            @trap();
        }
    }

    unsafe impl drop(may_dangle T) where T: !linear, T: recursive {
        fn drop(self: &mut Self) {
            if !enter_drop() {
                unsafe {
                    let later: *own Self = @alloc(Self, 1) as *own Self;
                    *later = Self { inner: self.inner, allocator: self.allocator };
                    defer_drop(fn(kept: usize) {
                        unsafe {
                            let kept = kept as *own Self;
                            let rc = move *kept;
                            @dealloc(kept);
                        }
                    }, later as usize);
                }
                return;
            }
            Self::release(self.inner, &self.allocator);
            leave_drop();
        }
    }

    /// Gives up one strong reference, dropping the value with the last.
    fn release(inner: *mut RcInner[T], allocator: &A) where T: !linear {
        unsafe {
            let n = (*inner).strong - 1;
            (*inner).strong = n;
            if n == 0 {
                // The block outlives this: a `Weak` the value holds to itself cannot free it.
                @drop(&raw mut (*inner).value as *mut T);
                rc_release_weak[T, A](inner, allocator);
            }
        }
    }

    /// One more reference to the value: what `clone` does, and for a linear `T`, whose
    /// `Rc` is linear too and so cannot `clone`, the way to share it.
    pub fn share(self: &Self) -> Self {
        let inner = self.inner;
        unsafe {
            let n = (*inner).strong;
            if n == MAX_REFS {
                @trap();
            }
            (*inner).strong = n + 1;
        }
        return Self { inner: self.inner, allocator: self.allocator };
    }

    pub(mod) fn from_inner(inner: *mut RcInner[T], allocator: A) -> Self {
        return Self { inner: inner, allocator: allocator };
    }

    pub fn new(value: T) -> Self where A: default {
        return Self::new_in(move value, @default(A));
    }

    /// `new`, or why there is no memory for it (and then `value` is dropped).
    pub fn try_new(value: T) -> AllocError!Self where A: default, T: !linear {
        let allocator: A = @default(A);
        let inner: *mut RcInner[T] = try try_alloc_in[RcInner[T], A](&allocator, 1);
        unsafe {
            *inner = RcInner[T] { strong: 1, weak: 1, value: uninit(move value) };
        }
        return Self { inner: inner, allocator: allocator };
    }

    pub fn new_in(value: T, allocator: A) -> Self borrows(value, allocator) {
        let inner: *mut RcInner[T] = unsafe { alloc_in[RcInner[T], A](&allocator, 1) };
        unsafe {
            *inner = RcInner[T] { strong: 1, weak: 1, value: uninit(move value) };
        }
        return Self { inner: inner, allocator: allocator };
    }

    pub fn get(self: &Self) -> &T {
        unsafe {
            return &*(&raw const (*self.inner).value as *const T);
        }
    }

    /// The value, if this is its only `Rc` and no `Weak` refers to it.
    pub fn get_mut(self: &mut Self) -> ?&mut T {
        if !self.is_unique() {
            return null;
        }
        unsafe {
            return &mut *(&raw mut (*self.inner).value as *mut T);
        }
    }

    /// The value to change: this `Rc`'s own, cloned first if anything else refers to it.
    pub fn make_mut(self: &mut Self) -> &mut T where T: clone {
        if !self.is_unique() {
            let copy = Self::new_in(@clone(self.get()), self.allocator);
            *self = copy;
        }
        unsafe {
            return &mut *(&raw mut (*self.inner).value as *mut T);
        }
    }

    /// The value, if this was its last `Rc`; otherwise this one is dropped, and `null`.
    pub fn into_inner(move self) -> ?T {
        let inner = self.inner;
        let allocator = self.allocator;
        unsafe {
            @forget(self);
            if (*inner).strong != 1 {
                (*inner).strong = (*inner).strong - 1;
                return null;
            }
            (*inner).strong = 0;
            let value = move *(&raw mut (*inner).value as *mut T);
            rc_release_weak[T, A](inner, &allocator);
            return value;
        }
    }

    /// The value, taken if this was its last `Rc` and cloned otherwise.
    pub fn unwrap_or_clone(move self) -> T where T: clone {
        if self.strong_count() == 1 {
            return self.into_inner() orelse unreachable;
        }
        return @clone(self.get());
    }

    /// A `Weak` reference to the value, which does not keep it alive.
    pub fn downgrade(self: &Self) -> Weak[T, A] {
        let inner = self.inner;
        unsafe {
            let w = (*inner).weak;
            if w == MAX_REFS {
                @trap();
            }
            (*inner).weak = w + 1;
        }
        return Weak[T, A]::from_inner(self.inner, self.allocator);
    }

    /// Whether `self` and `other` share a value.
    pub fn ptr_eq(self: &Self, other: &Self) -> bool {
        return self.inner as usize == other.inner as usize;
    }

    pub fn strong_count(self: &Self) -> usize {
        return unsafe { (*self.inner).strong };
    }

    pub fn weak_count(self: &Self) -> usize {
        return unsafe { (*self.inner).weak } - 1;
    }

    fn is_unique(self: &Self) -> bool {
        return unsafe { (*self.inner).strong == 1 && (*self.inner).weak == 1 };
    }
}

/// A reference to an `Rc`'s value that does not keep it alive: `upgrade` gives an `Rc` while
/// one remains. It keeps the counts' memory, but not the value's resources, until it is dropped.
pub opaque(!send, !sync) Weak[T: ?linear, A: Allocator + copy = Global] {
    /// Null for a `Weak` made by `new`, which refers to nothing.
    inner: *mut RcInner[T],
    allocator: A,

    impl clone {
        fn clone(self: &Self) -> Self {
            let inner = self.inner;
            if inner as usize != 0 {
                unsafe {
                    let w = (*inner).weak;
                    if w == MAX_REFS {
                        @trap();
                    }
                    (*inner).weak = w + 1;
                }
            }
            return Self { inner: self.inner, allocator: self.allocator };
        }
    }

    impl default where A: default {
        fn default() -> Self {
            return Self::new();
        }
    }

    unsafe impl drop(may_dangle T) {
        fn drop(self: &mut Self) {
            if self.inner as usize != 0 {
                rc_release_weak[T, A](self.inner, &self.allocator);
            }
        }
    }

    pub(mod) fn from_inner(inner: *mut RcInner[T], allocator: A) -> Self {
        return Self { inner: inner, allocator: allocator };
    }

    /// A `Weak` that refers to nothing, so never upgrades.
    pub fn new() -> Self where A: default {
        return Self { inner: 0 as *mut RcInner[T], allocator: @default(A) };
    }

    /// An `Rc` of the value, if one is still alive.
    pub fn upgrade(self: &Self) -> ?Rc[T, A] {
        if self.strong_count() == 0 {
            return null;
        }
        let inner = self.inner;
        unsafe {
            (*inner).strong = (*inner).strong + 1;
        }
        return Rc[T, A]::from_inner(self.inner, self.allocator);
    }

    /// Whether `self` and `other` refer to the same value (two made by `new` do).
    pub fn ptr_eq(self: &Self, other: &Self) -> bool {
        return self.inner as usize == other.inner as usize;
    }

    /// The `Rc`s of the value, 0 once it is dropped.
    pub fn strong_count(self: &Self) -> usize {
        if self.inner as usize == 0 {
            return 0;
        }
        return unsafe { (*self.inner).strong };
    }

    /// The `Weak`s of the value, 0 once it is dropped.
    pub fn weak_count(self: &Self) -> usize {
        if self.strong_count() == 0 {
            return 0;
        }
        return unsafe { (*self.inner).weak } - 1;
    }
}

/// What an `RcSlice` points at: the count, and its elements.
struct RcSliceInner[T] {
    strong: usize,
    len: usize,
    elems: *mut T,
}

/// Room for `len` elements of `T`: none for no elements, which then point nowhere.
pub fn alloc_elems[T, A: Allocator](allocator: &A, len: usize) -> *mut T {
    if len == 0 {
        return (@align_of(T) as usize) as *mut T;
    }
    return unsafe { alloc_in[T, A](allocator, len) };
}

pub fn dealloc_elems[T, A: Allocator](allocator: &A, elems: *mut T, len: usize) {
    if len != 0 {
        unsafe {
            dealloc_in[T, A](allocator, elems);
        }
    }
}

/// `Rc` of a slice: `[T]` shared by every `RcSlice` cloned from one another, its length kept
/// with the count, so the handle is one pointer. `get` gives `&[T]`. There is no weak form.
pub opaque(owns T, !send, !sync) RcSlice[T, A: Allocator + copy = Global] {
    inner: *mut RcSliceInner[T],
    allocator: A,

    impl clone {
        fn clone(self: &Self) -> Self {
            let header = self.inner;
            unsafe {
                let n = (*header).strong;
                if n == MAX_REFS {
                    @trap();
                }
                (*header).strong = n + 1;
            }
            return Self { inner: header, allocator: self.allocator };
        }
    }

    impl default where A: default {
        fn default() -> Self {
            return Self::with_len(0, @default(A));
        }
    }

    impl format where T: format {
        fn format(self: &Self, f: &mut Formatter) {
            @format(f, self.get());
        }
    }

    unsafe impl drop(may_dangle T) {
        fn drop(self: &mut Self) {
            let header = self.inner;
            unsafe {
                let n = (*header).strong - 1;
                (*header).strong = n;
                if n == 0 {
                    let elems = (*header).elems;
                    for i in 0..(*header).len {
                        @drop(elems + i);
                    }
                    dealloc_elems[T, A](&self.allocator, elems, (*header).len);
                    dealloc_in[RcSliceInner[T], A](&self.allocator, header);
                }
            }
        }
    }

    /// One reference to room for `len` elements, which the caller fills.
    fn with_len(len: usize, allocator: A) -> Self {
        let elems = alloc_elems[T, A](&allocator, len);
        let inner: *mut RcSliceInner[T] = unsafe { alloc_in[RcSliceInner[T], A](&allocator, 1) };
        unsafe {
            *inner = RcSliceInner[T] { strong: 1, len: len, elems: elems };
        }
        return Self { inner: inner, allocator: allocator };
    }

    fn elems(self: &Self) -> *mut T {
        return unsafe { (*self.inner).elems };
    }

    /// The elements of `items`, cloned.
    pub fn from_slice(items: &[T]) -> Self where T: clone, A: default {
        return Self::from_slice_in(items, @default(A));
    }

    pub fn from_slice_in(items: &[T], allocator: A) -> Self where T: clone {
        let out = Self::with_len(items.len, allocator);
        let elems = out.elems();
        for i in 0..items.len {
            unsafe {
                *(elems + i) = @clone(&items[i]);
            }
        }
        return out;
    }

    /// The elements of `items`, moved.
    pub fn from_vec(items: Vec[T]) -> Self where A: default {
        let mut items = items;
        let len = items.len();
        let out = Self::with_len(len, @default(A));
        let elems = out.elems();
        let mut i = len;
        while let item = items.pop() {
            i -= 1;
            unsafe {
                *(elems + i) = move item;
            }
        }
        return out;
    }

    pub fn get(self: &Self) -> &[T] {
        unsafe {
            return &(*(self.elems() as *const [T; 0]))[0..(*self.inner).len];
        }
    }

    /// The elements, if this is their only `RcSlice`.
    pub fn get_mut(self: &mut Self) -> ?&mut [T] {
        if self.strong_count() != 1 {
            return null;
        }
        unsafe {
            return &mut (*(self.elems() as *mut [T; 0]))[0..(*self.inner).len];
        }
    }

    pub fn len(self: &Self) -> usize {
        return unsafe { (*self.inner).len };
    }

    pub fn is_empty(self: &Self) -> bool {
        return self.len() == 0;
    }

    /// Whether `self` and `other` share their elements.
    pub fn ptr_eq(self: &Self, other: &Self) -> bool {
        return self.inner as usize == other.inner as usize;
    }

    pub fn strong_count(self: &Self) -> usize {
        return unsafe { (*self.inner).strong };
    }
}

/// `Rc` of a string: text shared by every `RcStr` cloned from one another, one pointer wide.
/// `as_str` reads it; it never changes.
pub opaque(!send, !sync) RcStr {
    bytes: RcSlice[u8],

    impl clone {
        fn clone(self: &Self) -> Self {
            return Self { bytes: self.bytes.clone() };
        }
    }

    impl default {
        fn default() -> Self {
            return Self::from("");
        }
    }

    impl format {
        fn format(self: &Self, f: &mut Formatter) {
            f.write_str(self.as_str());
        }
    }

    pub fn from(text: &str) -> Self {
        return Self { bytes: RcSlice[u8]::from_slice(text) };
    }

    pub fn as_str(self: &Self) -> &str {
        return self.bytes.get();
    }

    pub fn len(self: &Self) -> usize {
        return self.bytes.len();
    }

    pub fn is_empty(self: &Self) -> bool {
        return self.bytes.is_empty();
    }

    /// Whether `self` and `other` share their text (not only equal it).
    pub fn ptr_eq(self: &Self, other: &Self) -> bool {
        return self.bytes.ptr_eq(&other.bytes);
    }

    pub fn strong_count(self: &Self) -> usize {
        return self.bytes.strong_count();
    }
}

impl Hash for RcStr {
    fn hash(self: &Self) -> u64 {
        return hash_key[&str](self.as_str());
    }
}

impl Eq for RcStr {
    fn eq(self: &Self, other: &Self) -> bool {
        return self.as_str() == other.as_str();
    }
}

/// What a generator, a function declared `-> gen T`, returns: `next` runs its body to its next
/// `yield` and gives what that yields, or `null` once the body has returned. `B` is the tuple of
/// the generator's parameter types, so a `Gen` borrows what they do.
///
/// The body's locals live in a frame on the heap, which never moves, so they may refer to one
/// another across a `yield`. Dropping a `Gen` before its body returns ends the body where it
/// is waiting, as a `return` there would, dropping what is live.
pub opaque(owns B, !send, !sync) Gen[T: ?linear, B] {
    frame: *mut u8,
    resume: fn(*mut u8, *mut ?T, bool) -> bool,
    done: bool,

    impl drop {
        fn drop(self: &mut Self) {
            if !self.done {
                let mut slot: ?T = null;
                let resume = self.resume;
                _ = resume(self.frame, &raw mut slot, true);
                // Ending is not yielding: it stays empty.
                if let item = slot {
                    unreachable;
                }
            }
            unsafe {
                @dealloc(self.frame);
            }
        }
    }

    pub fn next(self: &mut Self) -> ?T borrows(*self) {
        if self.done {
            return null;
        }
        let mut slot: ?T = null;
        let resume = self.resume;
        if resume(self.frame, &raw mut slot, false) {
            self.done = true;
        }
        return slot;
    }
}
