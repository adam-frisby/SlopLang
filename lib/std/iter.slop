import std::sync::ResultOf;
import std::collections::{Vec, is_space};

/// What an iterator `I` gives: `T`, for any type with `next(self: &mut Self) -> ?T` (a `Gen`,
/// `Iter`, `IterMut`, ...).
pub fn ItemOf[I: unchecked] -> type {
    return @type_of((*(0 as *mut I)).next() orelse unreachable);
}

/// `f` of each item.
pub fn map[I: unchecked, F: unchecked](mut self: I, f: F) -> gen ResultOf[F] {
    while let item = self.next() {
        yield f(item);
    }
}

/// The items for which `keep` holds.
pub fn filter[I: unchecked, F: unchecked](mut self: I, keep: F) -> gen ItemOf[I] {
    while let item = self.next() {
        if keep(&item) {
            yield item;
        }
    }
}

/// The first `n` items.
pub fn take[I: unchecked](mut self: I, n: usize) -> gen ItemOf[I] {
    let mut left = n;
    while left > 0 {
        let item = self.next() orelse return;
        left -= 1;
        yield item;
    }
}

/// The items after the first `n`.
pub fn skip[I: unchecked](mut self: I, n: usize) -> gen ItemOf[I] {
    let mut left = n;
    while let item = self.next() {
        if left > 0 {
            left -= 1;
        } else {
            yield item;
        }
    }
}

/// The items, each with its index.
pub fn enumerate[I: unchecked](mut self: I) -> gen tuple { usize, ItemOf[I] } {
    let mut i: usize = 0;
    while let item = self.next() {
        yield { i, item };
        i += 1;
    }
}

/// Pairs of the items of `self` and `other`, as long as both have one.
pub fn zip[I: unchecked, J: unchecked](mut self: I, mut other: J) -> gen tuple { ItemOf[I], ItemOf[J] } {
    while let a = self.next() {
        let b = other.next() orelse return;
        yield { a, b };
    }
}

/// The items of `self`, then those of `other`.
pub fn chain[I: unchecked, J: unchecked](mut self: I, mut other: J) -> gen ItemOf[I] {
    while let item = self.next() {
        yield item;
    }
    while let item = other.next() {
        yield item;
    }
}

/// The items, in a `Vec`.
pub fn collect[I: unchecked](mut self: I) -> Vec[ItemOf[I]] {
    let mut out = Vec[ItemOf[I]]::new();
    while let item = self.next() {
        out.push(item);
    }
    return out;
}

/// How many items there are.
pub fn count[I: unchecked](mut self: I) -> usize {
    let mut n: usize = 0;
    while let item = self.next() {
        n += 1;
    }
    return n;
}

/// The lines of `self`, without their `\n` (or `\r\n`), and nothing after a final `\n`.
pub fn lines(self: &str) -> gen &str {
    let mut start: usize = 0;
    for i in 0..self.len {
        if self[i] == 10 {
            let mut end = i;
            if end > start && self[end - 1] == 13 {
                end -= 1;
            }
            yield self[start..end];
            start = i + 1;
        }
    }
    if start < self.len {
        yield self[start..self.len];
    }
}

/// The pieces of `self` between occurrences of `separator`, as `split` gives them, one at a
/// time.
pub fn split_iter(self: &str, separator: &str) -> gen &str {
    if separator.len == 0 {
        @trap();
    }
    let mut start: usize = 0;
    let mut i: usize = 0;
    while i + separator.len <= self.len {
        if self[i..i + separator.len] == separator {
            yield self[start..i];
            i += separator.len;
            start = i;
        } else {
            i += 1;
        }
    }
    yield self[start..self.len];
}

/// The words of `self`, as `words` gives them, one at a time.
pub fn words_iter(self: &str) -> gen &str {
    let mut start: usize = 0;
    let mut in_word = false;
    for i in 0..self.len {
        let space = is_space(self[i]);
        if space && in_word {
            yield self[start..i];
            in_word = false;
        } else if !space && !in_word {
            start = i;
            in_word = true;
        }
    }
    if in_word {
        yield self[start..self.len];
    }
}
