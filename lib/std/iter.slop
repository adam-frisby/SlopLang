import std::sync::ResultOf;
import std::collections::{Vec, Iter, IterMut, is_space};
import std::mem::{Gen, Storage};

/// An iterator: what `next` gives, until it gives `null`. Its other methods are adapters, each
/// a generator (so an iterator too), which an implementation may replace (a `count` that knows
/// its length, say). Those that drop items (`filter`, `skip`, `count`) need items that may be
/// dropped. `for` needs only a `next` method, so a type can be iterated without this,
/// but not adapted.
pub trait Iterator {
    const Item: ?linear;
    fn next(&mut self) -> ?Self::Item borrows(*self);

    /// `f` of each item.
    fn map[F: callable(Self::Item) -> ResultOf[F]](mut self, f: F) -> gen ResultOf[F] {
        while let ?item = self.next() {
            yield f(item);
        }
    }

    /// The items for which `keep` holds.
    fn filter[F: callable(&Self::Item) -> bool](mut self, keep: F) -> gen Self::Item where Self::Item: !linear {
        while let ?item = self.next() {
            if keep(&item) {
                yield item;
            }
        }
    }

    /// The first `n` items.
    fn take(mut self, n: usize) -> gen Self::Item {
        let mut left = n;
        while left > 0 {
            let item = self.next() orelse return;
            left -= 1;
            yield item;
        }
    }

    /// The items after the first `n`.
    fn skip(mut self, n: usize) -> gen Self::Item where Self::Item: !linear {
        let mut left = n;
        while let ?item = self.next() {
            if left > 0 {
                left -= 1;
            } else {
                yield item;
            }
        }
    }

    /// The items, each with its index.
    fn enumerate(mut self) -> gen tuple { usize, Self::Item } {
        let mut i: usize = 0;
        while let ?item = self.next() {
            yield .{ i, item };
            i += 1;
        }
    }

    /// Pairs of the items of `self` and `other`, as long as both have one.
    fn zip[J: Iterator](mut self, mut other: J) -> gen tuple { Self::Item, J::Item } {
        while let ?a = self.next() {
            let b = other.next() orelse return;
            yield .{ a, b };
        }
    }

    /// The items of `self`, then those of `other`, which gives the same type of item.
    fn chain[J: Iterator](mut self, mut other: J) -> gen Self::Item {
        while let ?item = self.next() {
            yield item;
        }
        while let ?item = other.next() {
            yield item;
        }
    }

    /// The items, in a `Vec`.
    fn collect(mut self) -> Vec[Self::Item] {
        let mut out = Vec[Self::Item]::new();
        // Pushed as it comes, not through a binding, which a `&mut` item would be reborrowed
        // from, and which the next turn overwrites.
        while true {
            out.push(self.next() orelse break);
        }
        return out;
    }

    /// The items, pushed onto `out`, until there are no more or there is no memory for one:
    /// then that one comes back, and those after it are still to come from `self`. Nothing is
    /// lost, so this takes linear items too.
    fn try_collect_into[S: Storage + ?linear](&mut self, out: &mut Vec[Self::Item, S]) -> ?Self::Item borrows(*self, out: *self) {
        while let ?item = self.next() {
            if let ?back = out.try_push(item) {
                return back;
            }
        }
        return null;
    }

    /// How many items there are.
    fn count(mut self) -> usize where Self::Item: !linear {
        let mut n: usize = 0;
        while let ?item = self.next() {
            n += 1;
        }
        return n;
    }
}

impl[T: ?linear, B] Iterator for Gen[T, B] {
    const Item: ?linear = T;
    fn next(&mut self) -> ?T borrows(*self) {
        return self.next();
    }
}

impl[T: ?linear] Iterator for Iter[T] {
    const Item: ?linear = &T;
    fn next(&mut self) -> ?&T borrows(*self) {
        return self.next();
    }
}

impl[T: ?linear] Iterator for IterMut[T] {
    const Item: ?linear = &mut T;
    fn next(&mut self) -> ?&mut T borrows(*self) {
        return self.next();
    }
}

/// The lines of `self`, without their `\n` (or `\r\n`), and nothing after a final `\n`.
pub fn lines(self: &str) -> gen &str {
    let mut start: usize = 0;
    for i in 0..self.len {
        if self[i] == 10 {
            let mut end = i;
            if end > start && self[end - 1] == 13 {
                end -= 1;
            }
            yield self[start..end];
            start = i + 1;
        }
    }
    if start < self.len {
        yield self[start..self.len];
    }
}

/// The pieces of `self` between occurrences of `separator`, as `split` gives them, one at a
/// time.
pub fn split_iter(self: &str, separator: &str) -> gen &str {
    if separator.len == 0 {
        @trap();
    }
    let mut start: usize = 0;
    let mut i: usize = 0;
    while i + separator.len <= self.len {
        if self[i..i + separator.len] == separator {
            yield self[start..i];
            i += separator.len;
            start = i;
        } else {
            i += 1;
        }
    }
    yield self[start..self.len];
}

/// The words of `self`, as `words` gives them, one at a time.
pub fn words_iter(self: &str) -> gen &str {
    let mut start: usize = 0;
    let mut in_word = false;
    for i in 0..self.len {
        let space = is_space(self[i]);
        if space && in_word {
            yield self[start..i];
            in_word = false;
        } else if !space && !in_word {
            start = i;
            in_word = true;
        }
    }
    if in_word {
        yield self[start..self.len];
    }
}
