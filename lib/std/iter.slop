import std::sync::ResultOf;
import std::collections::{Vec, Iter, IterMut, is_space};
import std::mem::Gen;

/// An iterator: what `next` gives, until it gives `null`. The adapters here (`map`, `filter`,
/// ...) take one, and are generators, so they are iterators too. `for` needs only a `next`
/// method, so a type can be iterated without this, but not adapted.
pub trait Iterator {
    const Item: ?linear;
    fn next(self: &mut Self) -> ?Self::Item borrows(*self);
}

impl[T: ?linear, B] Iterator for Gen[T, B] {
    const Item: ?linear = T;
    fn next(self: &mut Self) -> ?T borrows(*self) {
        return self.next();
    }
}

impl[T: ?linear] Iterator for Iter[T] {
    const Item: ?linear = &T;
    fn next(self: &mut Self) -> ?&T borrows(*self) {
        return self.next();
    }
}

impl[T: ?linear] Iterator for IterMut[T] {
    const Item: ?linear = &mut T;
    fn next(self: &mut Self) -> ?&mut T borrows(*self) {
        return self.next();
    }
}

/// `f` of each item.
pub fn map[I: Iterator, F: callable](mut self: I, f: F) -> gen ResultOf[F] {
    while let item = self.next() {
        yield f(item);
    }
}

/// The items for which `keep` holds.
pub fn filter[I: Iterator, F: callable](mut self: I, keep: F) -> gen I::Item {
    while let item = self.next() {
        if keep(&item) {
            yield item;
        }
    }
}

/// The first `n` items.
pub fn take[I: Iterator](mut self: I, n: usize) -> gen I::Item {
    let mut left = n;
    while left > 0 {
        let item = self.next() orelse return;
        left -= 1;
        yield item;
    }
}

/// The items after the first `n`.
pub fn skip[I: Iterator](mut self: I, n: usize) -> gen I::Item {
    let mut left = n;
    while let item = self.next() {
        if left > 0 {
            left -= 1;
        } else {
            yield item;
        }
    }
}

/// The items, each with its index.
pub fn enumerate[I: Iterator](mut self: I) -> gen tuple { usize, I::Item } {
    let mut i: usize = 0;
    while let item = self.next() {
        yield { i, item };
        i += 1;
    }
}

/// Pairs of the items of `self` and `other`, as long as both have one.
pub fn zip[I: Iterator, J: Iterator](mut self: I, mut other: J) -> gen tuple { I::Item, J::Item } {
    while let a = self.next() {
        let b = other.next() orelse return;
        yield { a, b };
    }
}

/// The items of `self`, then those of `other`, which gives the same type of item.
pub fn chain[I: Iterator, J: Iterator](mut self: I, mut other: J) -> gen I::Item {
    while let item = self.next() {
        yield item;
    }
    while let item = other.next() {
        yield item;
    }
}

/// The items, in a `Vec`.
pub fn collect[I: Iterator](mut self: I) -> Vec[I::Item] {
    let mut out = Vec[I::Item]::new();
    while let item = self.next() {
        out.push(item);
    }
    return out;
}

/// How many items there are.
pub fn count[I: Iterator](mut self: I) -> usize {
    let mut n: usize = 0;
    while let item = self.next() {
        n += 1;
    }
    return n;
}

/// The lines of `self`, without their `\n` (or `\r\n`), and nothing after a final `\n`.
pub fn lines(self: &str) -> gen &str {
    let mut start: usize = 0;
    for i in 0..self.len {
        if self[i] == 10 {
            let mut end = i;
            if end > start && self[end - 1] == 13 {
                end -= 1;
            }
            yield self[start..end];
            start = i + 1;
        }
    }
    if start < self.len {
        yield self[start..self.len];
    }
}

/// The pieces of `self` between occurrences of `separator`, as `split` gives them, one at a
/// time.
pub fn split_iter(self: &str, separator: &str) -> gen &str {
    if separator.len == 0 {
        @trap();
    }
    let mut start: usize = 0;
    let mut i: usize = 0;
    while i + separator.len <= self.len {
        if self[i..i + separator.len] == separator {
            yield self[start..i];
            i += separator.len;
            start = i;
        } else {
            i += 1;
        }
    }
    yield self[start..self.len];
}

/// The words of `self`, as `words` gives them, one at a time.
pub fn words_iter(self: &str) -> gen &str {
    let mut start: usize = 0;
    let mut in_word = false;
    for i in 0..self.len {
        let space = is_space(self[i]);
        if space && in_word {
            yield self[start..i];
            in_word = false;
        } else if !space && !in_word {
            start = i;
            in_word = true;
        }
    }
    if in_word {
        yield self[start..self.len];
    }
}
