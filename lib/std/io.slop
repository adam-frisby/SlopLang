pub import core::fmt::Formatter;
pub import std::fmt::{String, format};
import core::panic::PanicInfo;
extern fn poll(fds: *mut PollFd, count: usize, timeout_ms: i32) -> i32;

/// Why reading or writing stopped.
pub error IoError { Failed }

/// What `poll` reads and fills in.
struct PollFd {
    fd: i32,
    events: i16,
    revents: i16,
}

const POLL_IN: i16 = 1;
const POLL_OUT: i16 = 4;

/// `poll` promises this much room in a pipe, so a descriptor that blocks can take it at once.
const WRITE_CHUNK: usize = 4096;

const EINTR: i32 = 4;
const EAGAIN: i32 = 11;
const O_NONBLOCK: i32 = 2048;
const ECONNABORTED: i32 = 103;
const EINPROGRESS: i32 = 115;

fn os_error() -> i32 {
    return unsafe { __errno_location().* };
}

/// Blocks the thread until `fd` is ready for `events`.
fn wait_ready(fd: i32, events: i16) {
    while true {
        let mut one = PollFd { fd: fd, events: events, revents: 0 };
        if unsafe { poll(&raw mut one, 1, 1000) } > 0 {
            return;
        }
    }
}

/// An open file descriptor, closed on drop.
pub opaque Fd {
    raw: i32,

    /// Takes ownership of `raw`. Writing to something with no reader is then an error from
    /// `write_all`, not `SIGPIPE`, whose default ends the process: this ignores it for the whole
    /// process, which any C code in it will see.
    pub fn from_raw(raw: i32) -> Self {
        let _old = unsafe { signal(13, 1) };
        return Self { raw: raw };
    }

    /// What to do about a read or write that failed: wait for a non-blocking descriptor, try
    /// again after a signal, and fail otherwise.
    fn after_failure(&self, events: i16) -> IoError!void {
        let error = os_error();
        if error == EAGAIN {
            wait_ready(self.raw, events);
        } else if error != EINTR {
            return .Failed;
        }
    }

    pub fn raw(&self) -> i32 {
        return self.raw;
    }

    /// Reads what is available into `buf`, up to its length. 0 means the end of the stream.
    pub fn read(&self, buf: &mut [u8]) -> IoError!usize {
        if buf.len() == 0 {
            return 0;
        }
        while true {
            let n = unsafe { read(self.raw, &mut buf[0] as *mut u8, buf.len()) };
            if n >= 0 {
                return n as usize;
            }
            try self.after_failure(POLL_IN);
        }
        return .Failed;
    }

    /// Writes all of `data`. With no reader left this is `.Failed`.
    pub fn write_all(&self, data: &str) -> IoError!void {
        let mut done: usize = 0;
        while done < data.len() {
            let mut chunk = data.len() - done;
            if chunk > WRITE_CHUNK {
                chunk = WRITE_CHUNK;
            }
            let n = unsafe { write(self.raw, &data[done] as *const u8, chunk) };
            if n >= 0 {
                done = done + n as usize;
            } else {
                try self.after_failure(POLL_OUT);
            }
        }
    }

    impl drop {
        fn drop(&mut self) {
            let _rc = unsafe { close(self.raw) };
        }
    }
}

/// The two ends of a pipe.
pub struct Pipe {
    reader: Fd,
    writer: Fd,
}

pub fn open_pipe() -> ?Pipe {
    let mut fds: [i32; 2] = .{ 0, 0 };
    if unsafe { pipe(&raw mut fds) } != 0 {
        return null;
    }
    let _a = unsafe { fcntl(fds[0], 4, O_NONBLOCK) };
    let _b = unsafe { fcntl(fds[1], 4, O_NONBLOCK) };
    return Pipe { reader: Fd::from_raw(fds[0]), writer: Fd::from_raw(fds[1]) };
}

/// `sockaddr_in`.
struct SocketAddress {
    family: u16,
    port: u16,
    host: u32,
    zero: u64,
}

fn swap_bytes(port: u16) -> u16 {
    return (port >> 8) | (port << 8);
}

/// The dotted form of an IPv4 address, in the order the bytes have in memory, or null.
pub fn parse_ipv4(text: &str) -> ?u32 {
    let mut address: u32 = 0;
    let mut part: u32 = 0;
    let mut digits: usize = 0;
    let mut dots: u32 = 0;
    let mut at: usize = 0;
    while at <= text.len() {
        if at == text.len() || text[at] == 46 {
            if digits == 0 {
                return null;
            }
            address = address | (part << (dots * 8));
            part = 0;
            digits = 0;
            if at < text.len() {
                dots = dots + 1;
                if dots > 3 {
                    return null;
                }
            }
        } else {
            if text[at] < 48 || text[at] > 57 {
                return null;
            }
            part = part * 10 + (text[at] - 48) as u32;
            digits = digits + 1;
            if part > 255 || digits > 3 {
                return null;
            }
        }
        at = at + 1;
    }
    if dots != 3 {
        return null;
    }
    return address;
}

fn address_of(host: &str, port: u16) -> ?SocketAddress {
    let parsed = parse_ipv4(host) orelse return null;
    return SocketAddress { family: 2, port: swap_bytes(port), host: parsed, zero: 0 };
}

/// A TCP socket listening for connections.
pub opaque TcpListener {
    socket: Fd,

    /// Listens on `host`, an IPv4 address such as `127.0.0.1`. Port 0 picks a free one, which
    /// `port` then reports.
    pub fn bind(host: &str, port: u16) -> ?Self {
        let address = address_of(host, port) orelse return null;
        let raw = unsafe { socket(2, 1, 0) };
        if raw < 0 {
            return null;
        }
        let fd = Fd::from_raw(raw);
        let on: i32 = 1;
        let _rc = unsafe { setsockopt(raw, 1, 2, &raw const on, 4) };
        if unsafe { bind(raw, &raw const address, 16) } != 0 || unsafe { listen(raw, 128) } != 0 {
            return null;
        }
        return Self { socket: fd };
    }

    pub fn port(&self) -> u16 {
        let mut address = SocketAddress { family: 0, port: 0, host: 0, zero: 0 };
        let mut len: u32 = 16;
        let _rc = unsafe { getsockname(self.socket.raw(), &raw mut address, &raw mut len) };
        return swap_bytes(address.port);
    }

    /// Waits for a connection.
    pub fn accept(&self) -> IoError!Fd {
        while true {
            let raw = unsafe { accept4(self.socket.raw(), 0 as *mut u8, 0 as *mut u32, O_NONBLOCK) };
            if raw >= 0 {
                return Fd::from_raw(raw);
            }
            let error = os_error();
            if error == EAGAIN {
                wait_ready(self.socket.raw(), POLL_IN);
            } else if error != EINTR && error != ECONNABORTED {
                return .Failed;
            }
        }
        return .Failed;
    }
}

/// Connects to `port` on `host`, an IPv4 address, blocking the thread until it does.
pub fn connect_to(host: &str, port: u16) -> IoError!Fd {
    let address = address_of(host, port) orelse return .Failed;
    let raw = unsafe { socket(2, 1, 0) };
    if raw < 0 {
        return .Failed;
    }
    let fd = Fd::from_raw(raw);
    let flags = unsafe { fcntl(raw, 3, 0) };
    let _set = unsafe { fcntl(raw, 4, flags | O_NONBLOCK) };
    if unsafe { connect(raw, &raw const address, 16) } != 0 {
        if os_error() != EINPROGRESS {
            return .Failed;
        }
        wait_ready(raw, POLL_OUT);
        let mut failure: i32 = 0;
        let mut len: u32 = 4;
        let _rc = unsafe { getsockopt(raw, 1, 4, &raw mut failure, &raw mut len) };
        if failure != 0 {
            return .Failed;
        }
    }
    return fd;
}

/// Writes `count` bytes to `fd`, however many calls that takes, returning how many it managed.
fn write_fully(fd: i32, ptr: *const u8, count: usize) -> isize {
    let mut done: usize = 0;
    while done < count {
        let n = unsafe { write(fd, ptr + done, count - done) };
        if n >= 0 {
            done = done + n as usize;
        } else if os_error() != EINTR {
            break;
        }
    }
    return done as isize;
}

/// The panic handler of a program that declares none: writes `panic: message (where)` and the
/// error return trace to standard error, and traps. (The VM reports the same text as its error.)
pub fn default_panic(info: &PanicInfo) -> never {
    let mut place_buf: [u8; 256] = zeroinit;
    let place = core::panic::panic_place(info, &mut place_buf);
    let mut text_buf: [u8; 768] = zeroinit;
    let mut text = fmt_buf(&mut text_buf, info.message);
    if place.len() > 0 {
        text = fmt_buf(&mut text_buf, f"{info.message} ({place})");
    }
    panic_text(text);
}

/// Writes `panic: text` and the error return trace to standard error, and traps.
pub fn panic_text(text: &str) -> never {
    write_err("panic: ");
    write_err(text);
    write_err("\n");
    print_error_trace();
    @trap();
}

/// What a failed `try` in a test calls: `error` and where it was returned, reported as a failed
/// `@assert` is.
pub fn try_failed[E: format](error: &E, at: &str) -> never {
    let message = format(f"error returned: {error.*} ({at})");
    error_returned(message.as_str());
}

/// Reports a test's failed `try` as a panic is reported, with the error return trace. (The VM
/// reports it as its error.)
pub fn error_returned(message: &str) -> never {
    write_err(message);
    write_err("\n");
    print_error_trace();
    @trap();
}

// The error return trace of each thread (the VM keeps its own, and ignores these): where the
// error being returned now was returned from, innermost first. Lowering calls
// `error_trace_push` as a function returns an `E!T` holding its error, and
// `error_trace_handled` where a `catch` handles one. The first 16 entries are kept, then the
// last 16 in turn.
thread_local static mut TRACE_SITES: [?&str; 32] = @repeat(null, 32);
thread_local static mut TRACE_TOTAL: usize = 0;
/// The frame the last entry was returned from, as an address: one returned from a frame above
/// it (a caller, on a stack growing down) goes on with the trace.
thread_local static mut TRACE_FRAME: usize = 0;

/// `site` (`line L, column C in f`) returned an error from the frame at `frame`. A function of
/// std passing an error on is left out: only where it starts is shown.
pub fn error_trace_push(site: &str, frame: usize, in_std: bool) {
    unsafe {
        let going_on = TRACE_TOTAL > 0 && TRACE_FRAME < frame;
        TRACE_FRAME = frame;
        if !going_on {
            TRACE_TOTAL = 0;
        } else if in_std {
            return;
        }
        if TRACE_TOTAL < 32 {
            TRACE_SITES[TRACE_TOTAL] = site;
        } else {
            TRACE_SITES[16 + (TRACE_TOTAL - 16) % 16] = site;
        }
        TRACE_TOTAL += 1;
    }
}

/// A `catch` handled the error: its trace is over.
pub fn error_trace_handled() {
    unsafe {
        TRACE_TOTAL = 0;
    }
}

/// Writes the trace of the error being returned to stderr, as the VM does its own.
pub fn print_error_trace() {
    unsafe {
        if TRACE_TOTAL == 0 {
            return;
        }
        write_err("error return trace:\n");
        if TRACE_TOTAL <= 32 {
            for i in 0..TRACE_TOTAL {
                print_trace_site(i);
            }
        } else {
            for i in 0..16 {
                print_trace_site(i);
            }
            let mut buf: [u8; 64] = zeroinit;
            write_err(fmt_buf(&mut buf, f"  ... {TRACE_TOTAL - 32} more\n"));
            let start = (TRACE_TOTAL - 16) % 16;
            for k in 0..16 {
                print_trace_site(16 + (start + k) % 16);
            }
        }
    }
}

fn print_trace_site(i: usize) {
    unsafe {
        if let ?site = TRACE_SITES[i] {
            write_err("  returned at ");
            write_err(site);
            write_err("\n");
        }
    }
}

/// Writes `text` to standard error as it is, allocating nothing: what a panic writes with,
/// which may be about running out of memory.
fn write_err(text: &str) {
    if text.len() > 0 {
        let _written = write_fully(2, &text[0] as *const u8, text.len());
    }
}

pub fn print_str(s: &str) -> isize discardable {
    if s.len() == 0 {
        return 0;
    }
    return write_fully(1, &s[0] as *const u8, s.len());
}

/// Most output fits the buffer on the stack, and what does not goes through `format`.
fn emit[T: format](fd: i32, val: T, newline: bool) -> isize {
    let mut buf: [u8; 512] = @default([u8; 512]);
    let ptr = &mut buf[0] as *mut u8;
    let mut f = unsafe { Formatter::new(ptr, 512) };
    @format(&mut f, val);
    if newline {
        f.write_byte(10);
    }
    if !f.is_truncated() {
        return write_fully(fd, ptr as *const u8, f.len());
    }
    let mut text = format(val);
    if newline {
        text.push_byte(10);
    }
    let bytes = text.as_str();
    return write_fully(fd, &bytes[0] as *const u8, bytes.len());
}

pub fn print[T: format](val: T) -> isize discardable {
    return emit(1, val, false);
}

pub fn println[T: format](val: T) -> isize discardable {
    return emit(1, val, true);
}

pub fn eprint[T: format](val: T) -> isize discardable {
    return emit(2, val, false);
}

pub fn eprintln[T: format](val: T) -> isize discardable {
    return emit(2, val, true);
}

/// One line from standard input without its newline, or `null` at end of input.
pub fn read_line() -> ?String {
    let mut line = String::new();
    let mut b: u8 = 0;
    let mut got_any = false;
    while true {
        let n = unsafe { read(0, &mut b as *mut u8, 1) };
        if n <= 0 {
            break;
        }
        got_any = true;
        if b == 10 {
            break;
        }
        line.push_byte(b);
    }
    if !got_any {
        return null;
    }
    return line;
}

/// `path` as a NUL-terminated C string.
fn c_path(path: &str) -> String {
    let mut p = String::from(path);
    p.push_byte(0);
    return p;
}

/// The whole contents of the file at `path`, or `null` if it cannot be read.
pub fn read_file(path: &str) -> ?String {
    let p = c_path(path);
    let f = unsafe { fopen(&p.as_str()[0] as *const u8, "rb" as *const u8) } orelse return null;
    let mut out = String::new();
    let mut buf: [u8; 4096] = @default([u8; 4096]);
    while true {
        let n = unsafe { fread(&mut buf[0] as *mut u8, 1, 4096, f) };
        if n == 0 {
            break;
        }
        for i in 0..n {
            out.push_byte(buf[i]);
        }
    }
    let _ = unsafe { fclose(f) };
    return out;
}

/// Replaces the file at `path` with `contents`; `false` if it cannot be written.
pub fn write_file(path: &str, contents: &str) -> bool {
    let p = c_path(path);
    let f = unsafe { fopen(&p.as_str()[0] as *const u8, "wb" as *const u8) } orelse return false;
    let mut ok = true;
    if contents.len() > 0 {
        ok = unsafe { fwrite(&contents[0] as *const u8, 1, contents.len(), f) } == contents.len();
    }
    return unsafe { fclose(f) } == 0 && ok;
}
