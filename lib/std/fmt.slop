safe extern fn malloc(size: usize) -> *mut u8;
extern fn realloc(ptr: *mut u8, size: usize) -> *mut u8;
extern fn free(ptr: *mut u8);

pub import core::fmt::*;
import std::mem::{AllocError, out_of_memory};

/// A growable, heap-allocated UTF-8 string.
pub opaque String {
    ptr: ?*own u8,
    len: usize,
    cap: usize,

    impl drop {
        fn drop(self: &mut Self) {
            if let p = self.ptr {
                unsafe {
                    @dealloc(p);
                }
            }
        }
    }

    impl clone {
        fn clone(self: &Self) -> Self {
            return String::from(self.as_str());
        }
    }

    impl format {
        fn format(self: &Self, f: &mut Formatter) {
            f.write_str(self.as_str());
        }
    }

    pub fn new() -> Self {
        return Self { ptr: null, len: 0, cap: 0 };
    }

    pub fn with_capacity(cap: usize) -> Self {
        let mut s = Self::new();
        s.reserve(cap);
        return s;
    }

    /// `with_capacity`, or why there is no memory for it.
    pub fn try_with_capacity(cap: usize) -> AllocError!Self {
        let mut s = Self::new();
        try s.try_reserve(cap);
        return s;
    }

    pub fn from(text: &str) -> Self {
        let mut s = Self::with_capacity(text.len);
        s.push_str(text);
        return s;
    }

    /// `from`, or why there is no memory for it.
    pub fn try_from(text: &str) -> AllocError!Self {
        let mut s = try Self::try_with_capacity(text.len);
        s.write_str(text);
        return s;
    }

    /// A string taking ownership of `len` bytes at `ptr`, from `@alloc`.
    pub unsafe fn from_raw(ptr: *mut u8, len: usize) -> Self {
        return Self { ptr: unsafe { ptr as *own u8 }, len: len, cap: len };
    }

    pub fn len(self: &Self) -> usize {
        return self.len;
    }

    pub fn capacity(self: &Self) -> usize {
        return self.cap;
    }

    pub fn is_empty(self: &Self) -> bool {
        return self.len == 0;
    }

    /// Makes room for at least `extra` more bytes, or says why there is none (and then nothing
    /// changes). Pushes that use what is reserved cannot fail.
    pub fn try_reserve(self: &mut Self, extra: usize) -> AllocError!void {
        let need = (self.len +? extra) orelse return .TooLarge;
        if need <= self.cap {
            return;
        }
        let mut new_cap: usize = 16;
        if self.cap > 0 {
            new_cap = (self.cap *? 2) orelse need;
        }
        while new_cap < need {
            new_cap = (new_cap *? 2) orelse need;
        }
        let mut raw: *mut u8 = 0 as *mut u8;
        if let old_ptr = self.ptr {
            raw = unsafe { @raw_realloc(old_ptr as *mut u8, new_cap) };
        } else {
            raw = @raw_alloc(new_cap);
        }
        if (raw as usize) == 0 {
            return .OutOfMemory;
        }
        self.ptr = unsafe { raw as *own u8 };
        self.cap = new_cap;
    }

    /// `try_reserve`, trapping where it fails.
    pub fn reserve(self: &mut Self, extra: usize) {
        self.try_reserve(extra) catch |e| out_of_memory();
    }

    /// `push_byte`, or why there is no memory for it.
    pub fn try_push_byte(self: &mut Self, b: u8) -> AllocError!void {
        try self.try_reserve(1);
        self.write_byte(b);
    }

    /// `push_str`, or why there is no memory for it (and then nothing changes).
    pub fn try_push_str(self: &mut Self, text: &str) -> AllocError!void {
        try self.try_reserve(text.len);
        self.write_str(text);
    }

    /// `push`, or why there is no memory for it (and then nothing changes).
    pub fn try_push(self: &mut Self, c: rune) -> AllocError!void {
        try self.try_reserve(utf8_len(c));
        self.write_rune(c);
    }

    pub fn push_byte(self: &mut Self, b: u8) {
        self.reserve(1);
        self.write_byte(b);
    }

    pub fn push_str(self: &mut Self, text: &str) {
        self.reserve(text.len);
        self.write_str(text);
    }

    /// Appends `c` encoded as UTF-8.
    pub fn push(self: &mut Self, c: rune) {
        self.reserve(utf8_len(c));
        self.write_rune(c);
    }

    /// Writes into room already reserved, so allocates nothing.
    fn write_byte(self: &mut Self, b: u8) {
        let p = self.ptr orelse unreachable;
        unsafe {
            *(p + self.len) = b;
        }
        self.len += 1;
    }

    fn write_str(self: &mut Self, text: &str) {
        if text.len == 0 {
            return;
        }
        let p = self.ptr orelse unreachable;
        for (b, i) in text {
            unsafe {
                *(p + self.len + i) = b;
            }
        }
        self.len += text.len;
    }

    fn write_rune(self: &mut Self, c: rune) {
        let v = c as u32;
        if v < 128 {
            self.write_byte(v as u8);
        } else if v < 2048 {
            self.write_byte((192 | (v >> 6)) as u8);
            self.write_byte((128 | (v & 63)) as u8);
        } else if v < 65536 {
            self.write_byte((224 | (v >> 12)) as u8);
            self.write_byte((128 | ((v >> 6) & 63)) as u8);
            self.write_byte((128 | (v & 63)) as u8);
        } else {
            self.write_byte((240 | (v >> 18)) as u8);
            self.write_byte((128 | ((v >> 12) & 63)) as u8);
            self.write_byte((128 | ((v >> 6) & 63)) as u8);
            self.write_byte((128 | (v & 63)) as u8);
        }
    }

    pub fn clear(self: &mut Self) {
        self.len = 0;
    }

    pub fn as_str(self: &Self) -> &str {
        // An empty string may have no buffer: a zero length never dereferences the pointer.
        let mut p: *mut u8 = 1 as *mut u8;
        if let ptr = self.ptr {
            p = ptr;
        }
        unsafe {
            let arr_ref: &[u8; 0] = &*(p as *const [u8; 0]);
            return arr_ref[0..self.len];
        }
    }
}

/// How many bytes `c` takes in UTF-8.
fn utf8_len(c: rune) -> usize {
    let v = c as u32;
    if v < 128 {
        return 1;
    } else if v < 2048 {
        return 2;
    } else if v < 65536 {
        return 3;
    }
    return 4;
}

/// `format`, or why there is no memory for the string. Formatting itself allocates nothing
/// unless a `format` hook does.
pub fn try_format[T: format](val: T) -> AllocError!String {
    let cap: usize = 512;
    let raw: *mut u8 = @raw_alloc(cap);
    if (raw as usize) == 0 {
        return .OutOfMemory;
    }
    let mut f = unsafe { Formatter::new(raw, cap) };
    @format(&mut f, val);
    if !f.is_truncated() {
        return unsafe { String::from_raw(raw, f.len()) };
    }
    unsafe { @dealloc(raw); }
    let size = f.wanted();
    let whole: *mut u8 = @raw_alloc(size);
    if (whole as usize) == 0 {
        return .OutOfMemory;
    }
    let mut g = unsafe { Formatter::new(whole, size) };
    @format(&mut g, val);
    return unsafe { String::from_raw(whole, g.len()) };
}

pub fn format[T: format](val: T) -> String {
    let cap: usize = 512;
    let raw: *mut u8 = unsafe { @alloc(u8, cap) };
    let mut f = unsafe { Formatter::new(raw, cap) };
    @format(&mut f, val);
    if !f.is_truncated() {
        return unsafe { String::from_raw(raw, f.len()) };
    }
    // Now the size is known. Formatting twice runs a `format` hook twice.
    unsafe { @dealloc(raw); }
    let size = f.wanted();
    let whole: *mut u8 = unsafe { @alloc(u8, size) };
    let mut g = unsafe { Formatter::new(whole, size) };
    @format(&mut g, val);
    return unsafe { String::from_raw(whole, g.len()) };
}
