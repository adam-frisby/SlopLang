pub struct FieldSpec {
    pub name: &str,
    pub ty: type,
}

pub struct EnumSpec {
    pub name: &str,
    pub value: i64,
}

pub struct UnionSpec {
    pub name: &str,
    pub payload: type = void,
}

pub struct ErrorSpec {
    pub name: &str,
    pub payload: type = void,
}

pub struct StructField {
    pub name: &str,
    pub ty: type,
    pub offset: usize,
    pub has_default: bool,
}

pub struct TupleField {
    pub name: &str,
    pub index: usize,
    pub ty: type,
    pub offset: usize,
}

pub struct OverlayField {
    pub name: &str,
    pub ty: type,
}

pub struct EnumVariant[T: enum] {
    pub name: &str,
    pub value: @backing_type(T),
    pub val: T,
}

pub struct UnionVariant[T: union] {
    pub name: &str,
    pub payload: type,
    pub tag: T::Tag,
}

pub struct ErrorVariant {
    pub error_name: &str,
    pub name: &str,
    pub payload: type,
}

pub struct FnInfo {
    pub params: &[type],
    pub ret: type,
}

pub fn TupleConcat[A: ?linear, B: ?linear]() -> type {
    comptime let a = @fields(A);
    comptime let b = @fields(B);
    comptime let mut out: [type; a.len() + b.len()] = uninit;
    comptime for i in 0..a.len() { out[i] = a[i].ty; }
    comptime for i in 0..b.len() { out[a.len() + i] = b[i].ty; }
    return @Tuple(&out);
}

pub fn TupleTake[T: ?linear, N: usize]() -> type {
    if N > @fields(T).len() {
        return @compile_error("TupleTake: cannot take ", N, " elements of ", T);
    } else {
        comptime let mut out: [type; N] = uninit;
        comptime let src = @fields(T);
        comptime for i in 0..N { out[i] = src[i].ty; }
        return @Tuple(&out);
    }
}

pub fn TupleSkip[T: ?linear, N: usize]() -> type {
    if N > @fields(T).len() {
        return @compile_error("TupleSkip: cannot skip ", N, " elements of ", T);
    } else {
        comptime let src = @fields(T);
        comptime let mut out: [type; src.len() - N] = uninit;
        comptime for i in N..src.len() { out[i - N] = src[i].ty; }
        return @Tuple(&out);
    }
}

pub fn tuple_concat[A: unchecked, B: unchecked](a: A, b: B) -> TupleConcat[A, B] {
    let mut out: TupleConcat[A, B];
    comptime for f in @fields(A) { @field(out, f.index) = @field(a, f.index); }
    comptime for f in @fields(B) { @field(out, @fields(A).len() + f.index) = @field(b, f.index); }
    return out;
}

/// `a ++ b` of two arrays: `a`'s elements, then `b`'s, moved.
pub fn array_concat[T, N: usize, M: usize](mut a: [T; N], mut b: [T; M]) -> [T; N + M] {
    let mut out: [uninit T; N + M] = uninit;
    unsafe {
        let from_a = (&mut a as *mut [T; N] as usize) as *mut T;
        let from_b = (&mut b as *mut [T; M] as usize) as *mut T;
        for i in (0 as usize)..N {
            let slot = (&mut out[i] as *mut uninit T as usize) as *mut T;
            slot.* = move (from_a + i).*;
        }
        for i in (0 as usize)..M {
            let slot = (&mut out[N + i] as *mut uninit T as usize) as *mut T;
            slot.* = move (from_b + i).*;
        }
        @forget(a);
        @forget(b);
        return move ((&mut out as *mut [uninit T; N + M] as usize) as *mut [T; N + M]).*;
    }
}

/// `a ** K` of an array: its elements, `K` times over.
pub fn array_repeat[T: copy, N: usize, K: usize](a: [T; N]) -> [T; N * K] {
    let mut out: [uninit T; N * K] = uninit;
    unsafe {
        for i in (0 as usize)..(N * K) {
            let slot = (&mut out[i] as *mut uninit T as usize) as *mut T;
            slot.* = a[i % N];
        }
        return move ((&mut out as *mut [uninit T; N * K] as usize) as *mut [T; N * K]).*;
    }
}

/// The tuple of `T`'s elements, `K` times over.
pub fn TupleRepeat[T, K: usize]() -> type {
    comptime let src = @fields(T);
    comptime let mut out: [type; src.len() * K] = uninit;
    comptime for i in 0..(src.len() * K) { out[i] = src[i % src.len()].ty; }
    return @Tuple(&out);
}

/// `t ** K` of a tuple: its elements, `K` times over.
pub fn tuple_repeat[T: unchecked, K: usize](t: T) -> TupleRepeat[T, K] {
    let mut out: TupleRepeat[T, K];
    comptime for i in 0..(@fields(T).len() * K) { @field(out, i) = @field(t, i % @fields(T).len()); }
    return out;
}

pub fn tuple_split[N: usize, T: unchecked](t: T) -> tuple { TupleTake[T, N], TupleSkip[T, N] } {
    let mut head: TupleTake[T, N];
    let mut tail: TupleSkip[T, N];
    comptime for f in @fields(T) {
        if f.index < N {
            @field(head, f.index) = @field(t, f.index);
        } else {
            @field(tail, f.index - N) = @field(t, f.index);
        }
    }
    return .{ head, tail };
}

pub fn FieldAt[T, P: &[&str]]() -> type {
    if P.len() == 0 { return T; }
    comptime for f in @fields(T) {
        if f.name == P[0] { return FieldAt[f.ty, P[1..P.len()]]; }
    }
    return @compile_error("FieldAt: ", T, " has no field ", P[0]);
}
