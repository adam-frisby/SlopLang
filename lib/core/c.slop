import core::terminated::Terminated;

/// A C string: bytes ending at the first 0, as `const char*` passes them. It borrows them, as
/// a reference does. `to_str` reads it as a `&str` when it is UTF-8.
pub opaque(copy) CStr {
    chars: Terminated[u8, 0],

    /// The bytes from `p` to the first 0. Unsafe: they must stay there, unchanged, for as long
    /// as the `CStr` is used.
    pub unsafe fn from_ptr(p: *const u8) -> Self {
        return Self { chars: unsafe { Terminated[u8, 0]::from_ptr(p) } };
    }

    /// The bytes from a view of the first, which borrows them. Unsafe: a 0 must follow them in
    /// what is borrowed.
    pub unsafe fn from_view(p: *ref u8) -> Self {
        return Self { chars: unsafe { Terminated[u8, 0]::from_view(p) } };
    }

    pub fn as_ptr(&self) -> *const u8 {
        return self.chars.as_ptr();
    }

    /// How many bytes come before the 0.
    pub fn len(&self) -> usize {
        return self.chars.len();
    }

    /// The bytes before the 0.
    pub fn as_bytes(&self) -> &[u8] borrows(self.*) {
        return self.chars.as_slice();
    }

    /// The bytes before the 0 as a `&str`, or null when they are not UTF-8.
    pub fn to_str(&self) -> ?&str borrows(self.*) {
        let bytes = self.as_bytes();
        if !is_utf8(bytes) {
            return null;
        }
        let p = self.as_ptr();
        unsafe {
            let s: &str = p[0..bytes.len];
            return s;
        }
    }
}

/// Whether `bytes` are UTF-8: no overlong forms, surrogates, or code points past U+10FFFF.
pub fn is_utf8(bytes: &[u8]) -> bool {
    let mut i: usize = 0;
    while i < bytes.len {
        let b = bytes[i];
        if b < 0x80 {
            i += 1;
            continue;
        }
        let mut need: usize = 0;
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if b >= 0xC2 && b <= 0xDF {
            need = 1;
        } else if b == 0xE0 {
            need = 2;
            lo = 0xA0;
        } else if b == 0xED {
            need = 2;
            hi = 0x9F;
        } else if b >= 0xE1 && b <= 0xEF {
            need = 2;
        } else if b == 0xF0 {
            need = 3;
            lo = 0x90;
        } else if b == 0xF4 {
            need = 3;
            hi = 0x8F;
        } else if b >= 0xF1 && b <= 0xF3 {
            need = 3;
        } else {
            return false;
        }
        if i + need >= bytes.len {
            return false;
        }
        let second = bytes[i + 1];
        if second < lo || second > hi {
            return false;
        }
        for k in (2 as usize)..(need + 1) {
            let c = bytes[i + k];
            if c < 0x80 || c > 0xBF {
                return false;
            }
        }
        i += need + 1;
    }
    return true;
}
