// Counts words in a file with worker threads, and prints them, most common first.

const WORKERS: usize = 3;

fn count_range(all: &Vec[&str], from: usize, to: usize, totals: &Mutex[HashMap[&str, i32]]) -> i32 {
    for i in from..to {
        let word = (all.get(i) orelse unreachable).*;
        let mut guard = totals.lock();
        let map = guard.get_mut();
        if let ?n = map.get_mut(word) {
            n.* = n.* + 1;
        } else {
            let _old = map.insert(word, 1);
        }
        guard.unlock();
    }
    return 0;
}

struct Count {
    word: String,
    n: i32,
}

/// Most common first, then by word.
fn sorted(counts: &HashMap[&str, i32]) -> Vec[Count] {
    let mut out = Vec[Count]::new();
    let keys = counts.keys();
    for i in 0..keys.len() {
        let word = (keys.get(i) orelse unreachable).*;
        let n = (counts.get(word) orelse unreachable).*;
        out.push(Count { word: String::from(word), n: n });
    }
    out.sort_by(fn(a: &Count, b: &Count) -> bool {
        if a.n != b.n {
            return a.n > b.n;
        }
        return a.word.as_str().str_before(b.word.as_str());
    });
    return out;
}

/// Counts worker `w`'s share of `all`, and the later workers' shares, each on a thread of its
/// own, all running at once; each thread is joined on the way back.
fn count_on_threads(all: &Vec[&str], totals: &Mutex[HashMap[&str, i32]], w: usize) {
    if w == WORKERS {
        return;
    }
    let share = all.len() / WORKERS;
    let from = w * share;
    let mut to = from + share;
    if w == WORKERS - 1 {
        to = all.len();
    }
    let worker = spawn_scoped(fn() -> i32 { return count_range(all, from, to, totals); });
    count_on_threads(all, totals, w + 1);
    _ = worker.join();
}

pub fn main() -> i32 {
    let path = "/tmp/sloplang-wordcount-input.txt";
    let mut text = String::new();
    for i in 0..50 {
        text.push_str("the quick brown fox jumps over the lazy dog\n");
        if i % 5 == 0 {
            text.push_str("the end of the line\n");
        }
    }
    if !write_file(path, text.as_str()) {
        return 1;
    }
    let contents = read_file(path) orelse return 2;
    let all = contents.as_str().words();
    let totals = Mutex[HashMap[&str, i32]]::new(HashMap[&str, i32]::new());
    count_on_threads(&all, &totals, 0);
    let mut guard = totals.lock();
    let ranked = sorted(guard.get_mut());
    guard.unlock();
    for entry in ranked.iter() {
        println(f"{entry.n:4} {entry.word}");
    }
    println(f"{all.len()} words, {ranked.len()} different");
    return ranked.len() as i32;
}
