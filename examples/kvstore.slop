// A key-value server and a client, on fibers, on one thread.
//
//   SET name value    stores a value
//   GET name          the value, or NONE
//   COUNT             how many keys there are
//   QUIT              closes the connection

pub alias ProgramExecutor = Fibers;

pub struct Entry {
    key: String,
    value: String,
}

/// A store with a linear scan, which is what `String` keys need for now.
pub struct Store {
    entries: Vec[Entry],
}

fn find(store: &Store, key: &str) -> ?usize {
    for i in 0..store.entries.len() {
        let entry = store.entries.get(i) orelse unreachable;
        if entry.key.as_str() == key {
            return i;
        }
    }
    return null;
}

/// The words of `line`, split on spaces.
fn words(line: &str) -> Vec[String] {
    let mut out = Vec[String]::new();
    let mut word = String::new();
    for i in 0..line.len {
        if line[i] == 32 {
            if word.len() > 0 {
                out.push(move word);
                word = String::new();
            }
        } else {
            word.push_byte(line[i]);
        }
    }
    if word.len() > 0 {
        out.push(move word);
    }
    return out;
}

fn answer(store: &mut Store, line: &str) -> String {
    let parts = words(line);
    if parts.len() == 0 {
        return String::from("ERR empty");
    }
    let command = (parts.get(0) orelse unreachable).as_str();
    if command == "COUNT" {
        return format(store.entries.len());
    }
    if command == "GET" && parts.len() == 2 {
        let key = (parts.get(1) orelse unreachable).as_str();
        if let at = find(store, key) {
            let entry = store.entries.get(at) orelse unreachable;
            return String::from(entry.value.as_str());
        }
        return String::from("NONE");
    }
    if command == "SET" && parts.len() == 3 {
        let key = (parts.get(1) orelse unreachable).as_str();
        let value = (parts.get(2) orelse unreachable).as_str();
        if let at = find(store, key) {
            let entry = store.entries.get_mut(at) orelse unreachable;
            entry.value = String::from(value);
        } else {
            store.entries.push(Entry { key: String::from(key), value: String::from(value) });
        }
        return String::from("OK");
    }
    return String::from("ERR bad command");
}

/// One line from `conn`, or null at the end of the stream.
fn read_line_from(conn: &Fd, pending: &mut String) -> ?String {
    while true {
        let text = pending.as_str();
        for i in 0..text.len {
            if text[i] == 10 {
                let line = String::from(text[0..i]);
                let rest = String::from(text[(i + 1)..]);
                *pending = rest;
                return line;
            }
        }
        let mut buf: [u8; 256] = @default([u8; 256]);
        let n = conn.read(&mut buf) catch |e| return null;
        if n == 0 {
            return null;
        }
        for i in 0..n {
            pending.push_byte(buf[i]);
        }
    }
    return null;
}

fn serve(conn: Fd, store: &Mutex[Store]) -> i32 {
    let mut pending = String::new();
    let mut handled: i32 = 0;
    while let line = read_line_from(&conn, &mut pending) {
        if line.as_str() == "QUIT" {
            break;
        }
        let mut guard = store.lock();
        let mut reply = answer(guard.get_mut(), line.as_str());
        guard.unlock();
        reply.push_byte(10);
        let _sent = conn.write_all(reply.as_str()) catch |e| return handled;
        handled = handled + 1;
    }
    return handled;
}

fn accept_all(listener: &TcpListener, store: &Mutex[Store], count: i32) -> i32 {
    let mut total: i32 = 0;
    let mut tasks = Vec[Task[i32]]::new();
    for i in 0..count {
        let conn = listener.accept() catch |e| return -1;
        tasks.push(async serve(conn, store));
    }
    while let task = tasks.pop() {
        total = total + task.await();
    }
    return total;
}

fn ask(conn: &Fd, pending: &mut String, line: &str) -> String {
    let mut text = String::from(line);
    text.push_byte(10);
    let _sent = conn.write_all(text.as_str()) catch |e| return String::from("write failed");
    return read_line_from(conn, pending) orelse String::from("closed");
}

fn client(port: u16, name: &str, value: &str) -> i32 {
    let conn = connect_to("127.0.0.1", port) catch |e| return 1;
    let mut pending = String::new();
    let set = format(f"SET {name} {value}");
    let stored = ask(&conn, &mut pending, set.as_str());
    if stored.as_str() != "OK" {
        return 2;
    }
    let get = format(f"GET {name}");
    let got = ask(&conn, &mut pending, get.as_str());
    println(f"{name} = {got}");
    if got.as_str() != value {
        return 3;
    }
    let _quit = conn.write_all("QUIT\n") catch |e| return 4;
    return 0;
}

pub fn main() -> i32 {
    let listener = TcpListener::bind("127.0.0.1", 0) orelse return 10;
    let port = listener.port();
    let store = Mutex[Store]::new(Store { entries: Vec[Entry]::new() });
    let server = async accept_all(&listener, &store, 3);
    let a = async client(port, "alpha", "one");
    let b = async client(port, "beta", "two");
    let c = async client(port, "gamma", "three");
    let failures = a.await() + b.await() + c.await();
    let handled = server.await();
    println(f"{handled} requests, {failures} failures");
    let mut guard = store.lock();
    let keys = guard.get_mut().entries.len() as i32;
    guard.unlock();
    return failures * 100 + keys;
}
